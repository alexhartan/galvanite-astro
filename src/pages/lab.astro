---
import BaseLayout from '../layouts/BaseLayout.astro';
import CameraLab from '../components/ui/CameraLab.astro';
import Hero from '../components/sections/Hero.astro';
import Intro from '../components/sections/Intro.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import { hero, label, mission } from '../data/home';
---

<BaseLayout
  title="Camera lab | Galvanite"
  description="Internal playground for tuning the hero camera motion."
  noindex
>
  <SiteHeader slot="header" />
  <Hero {...hero} />
  <Intro label={label('intro')} {...mission} />
  <CameraLab />
</BaseLayout>
