---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedWork from '../components/sections/FeaturedWork.astro';
import Hero from '../components/sections/Hero.astro';
import Intro from '../components/sections/Intro.astro';
import SectionLink from '../components/ui/SectionLink.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import WhyGalvanite from '../components/sections/WhyGalvanite.astro';

const hero = {
  lead: 'We make highly technical products',
  emphasis: 'feel inevitable',
  description:
    'A lean creative studio focused on making technical products clear, compelling and easy to choose.',
};
const mission = {
  label: 'Our mission',
  statement: 'We create brands and digital experiences that',
  emphasis: 'bring the value of your product to light',
};
const sections = [
  { href: '#intro', label: 'Our mission' },
  { href: '#work', label: 'Featured work' },
  { href: '#why', label: 'Why Galvanite' },
];
const why = {
  label: 'Why Galvanite',
  contrast: 'Other agencies focus on outputs.',
  statement: 'We deliver results.',
};
const link = (index: number) => ({
  ...sections[index]!,
  position: sections.length - 1 - index,
});
---

<BaseLayout
  title="Galvanite | Technical products made inevitable"
  description={hero.description}
>
  <SiteHeader slot="header" />
  <Hero {...hero} />
  <SectionLink {...link(0)} />
  <Intro {...mission} />
  <SectionLink {...link(1)} />
  <FeaturedWork label="Featured work" />
  <SectionLink {...link(2)} />
  <WhyGalvanite {...why} />
</BaseLayout>
