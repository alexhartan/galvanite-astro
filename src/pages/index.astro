---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCta from '../components/sections/ClosingCta.astro';
import FeaturedWork from '../components/sections/FeaturedWork.astro';
import Faq from '../components/sections/Faq.astro';
import Hero from '../components/sections/Hero.astro';
import Intro from '../components/sections/Intro.astro';
import Results from '../components/sections/Results.astro';
import Pricing from '../components/sections/Pricing.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import SelfCheck from '../components/sections/SelfCheck.astro';
import SectionLink from '../components/ui/SectionLink.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import WhyGalvanite from '../components/sections/WhyGalvanite.astro';
import {
  check,
  closing,
  faq,
  hero,
  label,
  mission,
  pricing,
  results,
  sections,
  testimonials,
  why,
  type SectionId,
} from '../data/home';

const link = (id: SectionId) => {
  const index = sections.findIndex((section) => section.id === id);
  const { label, dark } = { dark: false, ...sections[index]! };
  return {
    href: `#${id}`,
    label,
    dark,
    position: sections.length - 1 - index,
  };
};
---

<BaseLayout
  title="Galvanite | Technical products made inevitable"
  description={hero.description}
>
  <SiteHeader slot="header" />
  <Hero {...hero} />
  <SectionLink {...link('intro')} />
  <Intro label={label('intro')} {...mission} />
  <SectionLink {...link('work')} />
  <FeaturedWork label={label('work')} sceneStart />
  <Results {...results} />
  <SectionLink {...link('engagements')} />
  <Pricing label={label('engagements')} {...pricing} />
  <SectionLink {...link('testimonials')} />
  <Testimonials label={label('testimonials')} {...testimonials} />
  <SectionLink {...link('why')} />
  <WhyGalvanite label={label('why')} {...why} />
  <SelfCheck {...check} />
  <SectionLink {...link('faq')} />
  <Faq label={label('faq')} {...faq} />
  <ClosingCta {...closing} />
</BaseLayout>
