---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCta from '../components/sections/ClosingCta.astro';
import FeaturedWork from '../components/sections/FeaturedWork.astro';
import Faq from '../components/sections/Faq.astro';
import Hero from '../components/sections/Hero.astro';
import Intro from '../components/sections/Intro.astro';
import Results from '../components/sections/Results.astro';
import Pricing from '../components/sections/Pricing.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import SelfCheck from '../components/sections/SelfCheck.astro';
import SectionLink from '../components/ui/SectionLink.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import WhyGalvanite from '../components/sections/WhyGalvanite.astro';

const hero = {
  eyebrow: 'AI Native Creative Studio for Data/AI Companies',
  lead: 'We make highly technical products',
  emphasis: 'feel inevitable',
  description:
    'A lean creative studio focused on making technical products clear, compelling and easy to choose.',
};
const mission = {
  label: 'Our mission',
  statement: [
    { text: 'Premium brands and websites for ' },
    { text: 'technical products ', strong: true },
    { text: 'that ' },
    { text: 'outgrew their story', strong: true },
    { text: '.' },
  ],
};
const sections = [
  { href: '#intro', label: 'Our Mission' },
  { href: '#work', label: 'Featured Work' },
  { href: '#engagements', label: 'Pricing', dark: true },
  { href: '#testimonials', label: 'Testimonials', dark: true },
  { href: '#why', label: 'Why Galvanite' },
  { href: '#fit', label: 'Self Check', dark: true },
  { href: '#faq', label: 'FAQ', dark: true },
];
const results = {
  lead: 'Others ship deliverables.',
  emphasis: 'We ship results.',
  stats: [
    {
      value: '120M+',
      label: 'In total client acquisitions\nover the past 2 years',
      href: '#',
    },
    {
      value: '60 days',
      label: 'From rebrand and launch\nto successful exit',
      href: '#',
    },
    {
      value: '3.62x',
      label: 'Boost in organic search traffic,\nwithin the first month',
      href: '#',
    },
  ],
};
const closing = {
  lead: 'It’s time to build a brand',
  emphasis: 'worthy of your product',
  description:
    'Book a 30-minute discovery call. We look at your site together, find where the value gets lost, and agree on the first steps.',
};
const why = {
  label: 'Why Galvanite',
  heading: 'Built with intent',
};
const link = (index: number) => ({
  ...sections[index]!,
  position: sections.length - 1 - index,
});
---

<BaseLayout
  title="Galvanite | Technical products made inevitable"
  description={hero.description}
>
  <SiteHeader slot="header" />
  <Hero {...hero} />
  <SectionLink {...link(0)} />
  <Intro {...mission} />
  <SectionLink {...link(1)} />
  <FeaturedWork label="Featured work" sceneStart />
  <Results {...results} />
  <SectionLink {...link(2)} />
  <Pricing label="Pricing" heading="How we" emphasis="work together" />
  <SectionLink {...link(3)} />
  <Testimonials label="Testimonials" heading="Don’t take our word for it" />
  <SectionLink {...link(4)} />
  <WhyGalvanite {...why} />
  <SectionLink {...link(5)} />
  <SelfCheck label="Self check" heading="What’s holding you back?" />
  <SectionLink {...link(6)} />
  <Faq
    label="FAQ"
    heading={`Questions,
answered`}
  />
  <ClosingCta {...closing} />
</BaseLayout>
