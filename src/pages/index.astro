---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCta from '../components/sections/ClosingCta.astro';
import FeaturedWork from '../components/sections/FeaturedWork.astro';
import Hero from '../components/sections/Hero.astro';
import Intro from '../components/sections/Intro.astro';
import Pricing from '../components/sections/Pricing.astro';
import SectionLink from '../components/ui/SectionLink.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import WhyGalvanite from '../components/sections/WhyGalvanite.astro';

const hero = {
  lead: 'We make highly technical products',
  emphasis: 'feel inevitable',
  description:
    'A lean creative studio focused on making technical products clear, compelling and easy to choose.',
};
const mission = {
  label: 'Our mission',
  statement: [
    { text: 'We make complex products easier to ' },
    { text: 'understand', strong: true },
    { text: ', ' },
    { text: 'recognize', strong: true },
    { text: ' and ' },
    { text: 'choose', strong: true },
    { text: ' through memorable branding and digital experiences.' },
  ],
};
const sections = [
  { href: '#intro', label: 'Our mission' },
  { href: '#work', label: 'Featured work' },
  { href: '#engagements', label: 'Engagements' },
  { href: '#why', label: 'Why Galvanite' },
];
const why = {
  label: 'Why Galvanite',
  heading: 'Why teams choose Galvanite',
  stats: [
    { value: '2 months', label: 'From rebrand and launch to successful exit' },
    { value: '120M+', label: 'In acquisitions after the rebrand and launch' },
    {
      value: '16+ years',
      label: 'Experience in branding and product development',
    },
  ],
};
const closing = {
  lead: 'It’s time to give your product',
  emphasis: 'the brand it deserves',
  description:
    'Book a 30-minute discovery call. We look at your site together, find where the value gets lost, and agree on the first steps.',
};
const link = (index: number) => ({
  ...sections[index]!,
  position: sections.length - 1 - index,
});
---

<BaseLayout
  title="Galvanite | Technical products made inevitable"
  description={hero.description}
>
  <SiteHeader slot="header" />
  <Hero {...hero} />
  <SectionLink {...link(0)} />
  <Intro {...mission} />
  <SectionLink {...link(1)} />
  <FeaturedWork label="Featured work" />
  <SectionLink {...link(2)} />
  <Pricing label="Engagements" heading="Ways to work together" />
  <SectionLink {...link(3)} />
  <WhyGalvanite {...why} />
  <ClosingCta {...closing} />
</BaseLayout>
