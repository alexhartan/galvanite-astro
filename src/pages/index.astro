---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedWork from '../components/sections/FeaturedWork.astro';
import Hero from '../components/sections/Hero.astro';
import Intro from '../components/sections/Intro.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';

const hero = {
  lead: 'We make highly technical products feel',
  emphasis: 'inevitable',
  description:
    'A lean creative studio focused on making technical products clear, compelling and easy to choose.',
};
const mission = {
  label: 'Our mission',
  statement: 'We create brands and digital experiences that',
  emphasis: 'bring the value of your product to light',
};
---

<BaseLayout
  title="Galvanite | Technical products made inevitable"
  description={hero.description}
>
  <SiteHeader slot="header" />
  <Hero {...hero} />
  <Intro {...mission} />
  <FeaturedWork label="Featured work" />
</BaseLayout>
