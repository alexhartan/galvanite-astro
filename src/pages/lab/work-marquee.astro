---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedWork from '../../components/sections/FeaturedWork.astro';
import Hero from '../../components/sections/Hero.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';

const hero = {
  eyebrow: 'AI Native Creative Studio for Data/AI Companies',
  lead: 'We make highly technical products',
  emphasis: 'feel inevitable',
  description:
    'A lean creative studio focused on making technical products clear, compelling and easy to choose.',
};
---

<BaseLayout
  title="Work marquee | Galvanite"
  description="Internal preview of the case studies as an auto-scrolling marquee."
  noindex
>
  <SiteHeader slot="header" />
  <Hero {...hero} />
  <FeaturedWork label="Featured work" layout="marquee" sceneStart />
  <div class="h-svh"></div>
</BaseLayout>
