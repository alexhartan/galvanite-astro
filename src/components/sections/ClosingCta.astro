---
import Container from '../ui/Container.astro';
import SectionFrame from '../ui/SectionFrame.astro';

interface Props {
  id?: string;
  lead: string;
  emphasis: string;
  description: string;
  ctaHref?: string;
}
const {
  id = 'contact',
  lead,
  emphasis,
  description,
  ctaHref = '#contact',
} = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  data-tone="light"
  class="scroll-mt-nav relative z-10 overflow-hidden bg-white"
>
  <SectionFrame />
  <div class="border-ink/10 relative border-t">
    <Container class="@container py-28 lg:py-44">
      <h2
        id={`${id}-heading`}
        class="text-statement lg:text-mission text-ink leading-none font-extralight"
      >
        {lead} <strong class="block font-medium">{emphasis}</strong>
      </h2>
      <p class="text-ink/70 mt-4 max-w-lead">{description}</p>
      <a
        href={ctaHref}
        class="bg-signal hover:bg-signal-strong text-ink ease-out-soft focus-visible:outline-ink mt-8 flex h-12 w-full max-w-80 items-center justify-center rounded-sm font-semibold transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        Book a Call with Alex
      </a>
    </Container>
  </div>
</section>
