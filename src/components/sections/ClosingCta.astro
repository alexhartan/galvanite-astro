---
import CtaButton from '../ui/CtaButton.astro';
import Container from '../ui/Container.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import Section from '../ui/Section.astro';
import SectionFrame from '../ui/SectionFrame.astro';

interface Props {
  id?: string;
  lead: string;
  emphasis: string;
  description: string;
  ctaHref?: string;
}
const {
  id = 'contact',
  lead,
  emphasis,
  description,
  ctaHref = '#contact',
} = Astro.props;
---

<Section id={id} labelledby={`${id}-heading`}>
  <SectionFrame edge={false} top={false} />
  <div class="relative overflow-clip">
    <Container class="@container py-48 lg:py-60">
      <div data-parallax="0.125" class="translate-y-(--shift)">
        <SplitHeading
          id={`${id}-heading`}
          lead={lead}
          emphasis={emphasis}
          emphasisClass="block font-medium"
          class="text-statement lg:text-statement-lg text-ink leading-none font-extralight"
        />
        <p class="text-ink/70 mt-4 max-w-lead">{description}</p>
        <CtaButton href={ctaHref} class="relative mt-8 w-full max-w-80">
          Book a Call with Alex
        </CtaButton>
      </div>
    </Container>
  </div>
</Section>

<script>
  import '../../scripts/parallax';
</script>
