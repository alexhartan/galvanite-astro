---
import CtaButton from '../ui/CtaButton.astro';
import Container from '../ui/Container.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import Section from '../ui/Section.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import GridGallery from '../ui/GridGallery.astro';

interface Props {
  id?: string;
  lead: string;
  emphasis: string;
  description: string;
  ctaHref?: string;
}
const {
  id = 'contact',
  lead,
  emphasis,
  description,
  ctaHref = '#contact',
} = Astro.props;
---

<Section id={id} labelledby={`${id}-heading`} tone="dark">
  <SectionFrame inverted edge={false} markRight />
  <div class="border-line-dark relative overflow-clip border-t">
    <GridGallery class="right-gutter left-3/5 max-xl:hidden" />
    <Container class="@container py-48 lg:py-60">
      <div data-parallax="0.125" class="w-fit translate-y-(--shift)">
        <SplitHeading
          id={`${id}-heading`}
          lead={lead}
          emphasis={emphasis}
          emphasisClass="block font-medium"
          class="text-statement lg:text-statement-lg leading-none font-extralight text-white"
        />
        <p class="max-w-lead mt-4 text-white/80">{description}</p>
        <CtaButton href={ctaHref} class="relative mt-8 w-full max-w-80">
          Book a Call with Alex
        </CtaButton>
      </div>
    </Container>
  </div>
</Section>

<script>
  import '../../scripts/parallax';
</script>
