---
import CtaButton from '../ui/CtaButton.astro';
import Container from '../ui/Container.astro';
import SectionFrame from '../ui/SectionFrame.astro';

interface Props {
  id?: string;
  lead: string;
  emphasis: string;
  description: string;
  ctaHref?: string;
}
const {
  id = 'contact',
  lead,
  emphasis,
  description,
  ctaHref = '#contact',
} = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  data-tone="light"
  class="scroll-mt-nav relative z-10 overflow-x-clip bg-white"
>
  <SectionFrame />
  <div class="border-line relative overflow-clip border-t">
    <Container class="@container py-40 lg:py-60">
      <div data-parallax class="translate-y-(--shift)">
        <h2
          id={`${id}-heading`}
          class="text-statement lg:text-statement-lg text-ink leading-none font-extralight"
        >
          {lead} <strong class="block font-medium">{emphasis}</strong>
        </h2>
        <p class="text-ink/70 mt-4 max-w-lead">{description}</p>
        <CtaButton href={ctaHref} class="relative mt-8 w-full max-w-80">
          Book a Call with Alex
        </CtaButton>
      </div>
    </Container>
  </div>
</section>

<script>
  import { initParallax } from '../../scripts/parallax';

  for (const element of document.querySelectorAll<HTMLElement>(
    '#contact [data-parallax]',
  )) {
    initParallax(element, 0.25);
  }
</script>
