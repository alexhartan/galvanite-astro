---
import Container from '../ui/Container.astro';
import GridMark from '../ui/GridMark.astro';

interface Props {
  id?: string;
  lead: string;
  emphasis: string;
  stats: { value: string; label: string; href: string }[];
  linkLabel?: string;
}
const {
  id = 'results',
  lead,
  emphasis,
  stats,
  linkLabel = 'See Featured Case Study',
} = Astro.props;
const marks = [
  'left-0',
  'left-1/3 max-sm:hidden',
  'left-2/3 max-sm:hidden',
  'left-full',
];
const motion =
  'ease-out-soft transition duration-500 motion-reduce:transition-none';
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  data-tone="light"
  class="relative z-10 overflow-x-clip bg-white"
>
  <Container class="pointer-events-none absolute inset-0">
    <div class="bg-ink/10 pointer-events-none z-10 absolute inset-y-0 left-6 w-px"></div>
  </Container>
  <Container class="pt-36 lg:pt-56 4xl:pt-24">
    <h2 id={`${id}-heading`} class="text-section text-center">
      <span class="text-sky block">{lead}</span>
      <span class="text-ink block font-normal">{emphasis}</span>
    </h2>
    <div data-results class="relative mt-9 lg:mt-11">
      <div
        aria-hidden="true"
        class="bg-navy/3 bleed-x absolute inset-y-0"
      ></div>
      <div
        aria-hidden="true"
        class="bg-ink/10 pointer-events-none z-10 bleed-x absolute top-0 h-px"
      ></div>
      <div
        aria-hidden="true"
        class="bg-ink/10 pointer-events-none z-10 absolute inset-x-0 bottom-0 h-px"
      ></div>
      <div
        aria-hidden="true"
        class="bg-ink/10 pointer-events-none z-10 absolute inset-y-0 left-1/3 w-px max-sm:hidden"
      ></div>
      <div
        aria-hidden="true"
        class="bg-ink/10 pointer-events-none z-10 absolute inset-y-0 left-2/3 w-px max-sm:hidden"
      ></div>
      <div
        aria-hidden="true"
        class="bg-ink/10 pointer-events-none z-10 absolute inset-y-0 right-0 w-px"
      ></div>
      {marks.map((mark) => (
        <>
          <GridMark class:list={['absolute top-0 z-10', mark]} />
          <GridMark class:list={['absolute top-full z-10', mark]} />
        </>
      ))}
      <ul role="list" class="grid sm:grid-cols-3">
        {stats.map(({ value, label, href }, index) => (
          <li class="relative" style={`--delay: ${index * 150}ms`}>
            <a
              href={href}
              class:list={[
                'group hover:bg-white focus-visible:bg-white focus-visible:outline-ocean relative flex h-full flex-col overflow-clip px-8 pt-15 focus-visible:outline-2 focus-visible:-outline-offset-2 lg:px-14 lg:pt-21',
                motion,
              ]}
            >
              <span class:list={['flex flex-col gap-1', motion]}>
                <span
                  class:list={[
                    'text-stat text-azure-deep group-hover:text-ocean group-focus-visible:text-ocean origin-bottom-left font-light pointer-fine:group-hover:scale-125 pointer-fine:group-focus-visible:scale-125',
                    motion,
                  ]}
                >
                  <span class="reveal-line-mask block">
                    <span class="reveal-rise block">{value}</span>
                  </span>
                </span>
                <span class="reveal-fade">
                  <span
                    class:list={[
                      'text-stat-label block text-graphite/70 group-hover:text-graphite group-focus-visible:text-graphite whitespace-pre-line',
                      motion,
                    ]}
                  >
                    {label}
                  </span>
                </span>
              </span>
              <span
                class:list={[
                  'text-ink mt-auto pt-15 pb-3 text-link-sm font-medium pointer-fine:translate-y-4 pointer-fine:opacity-0 pointer-fine:group-hover:translate-y-0 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-visible:translate-y-0 pointer-fine:group-focus-visible:opacity-100',
                  motion,
                ]}
              >
                {linkLabel}
              </span>
              <span
                aria-hidden="true"
                class:list={[
                  'bg-signal absolute right-0 bottom-0 left-8 h-1 pointer-fine:translate-y-full pointer-fine:group-hover:translate-y-0 pointer-fine:group-focus-visible:translate-y-0 lg:left-14',
                  motion,
                ]}
              ></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Container>
</section>

<script>
  import { initImageReveal } from '../../scripts/image-reveal';

  for (const root of document.querySelectorAll<HTMLElement>('[data-results]')) {
    initImageReveal(root, '0px');
  }
</script>
