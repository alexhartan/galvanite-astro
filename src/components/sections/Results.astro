---
import Container from '../ui/Container.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import Section from '../ui/Section.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import ColumnLines from '../ui/ColumnLines.astro';

interface Props {
  id?: string;
  lead: string;
  emphasis: string;
  stats: { value: string; label: string; href: string }[];
  linkLabel?: string;
}
const {
  id = 'results',
  lead,
  emphasis,
  stats,
  linkLabel = 'See Relevant Case Study',
} = Astro.props;
const motion = 'transition motion-slow';
---

<Section id={id} tone="dark" labelledby={`${id}-heading`}>
  <SectionFrame class="z-10" inverted edge={false} top={false} />
  <div class="border-line-dark relative border-t">
    <Container class="pt-36 pb-16 lg:pt-64 lg:pb-36 4xl:pt-56">
      <SplitHeading
        id={`${id}-heading`}
        lead={lead}
        emphasis={emphasis}
        leadClass="text-sky block"
        emphasisClass="text-white block font-normal"
        class="text-section text-center"
      />
      <div data-results class="relative mt-9 lg:mt-11">
        <div
          aria-hidden="true"
          class="bg-line-dark pointer-events-none z-10 bleed-x absolute top-0 h-px"
        ></div>
        <ColumnLines
          class="sm:grid-cols-3"
          columns={['hidden sm:block', 'hidden sm:block', '']}
          inverted
          edge="bg-line-dark -bottom-16 lg:-bottom-36"
          line="z-10"
          mark="z-20"
        />
        <ul role="list" class="grid sm:grid-cols-3">
          {stats.map(({ value, label, href }, index) => (
            <li class="relative" style={`--delay: ${index * 150}ms`}>
              <a
                href={href}
                class:list={[
                  'peer group isolate before:from-space-950/50 before:to-space-950/0 before:absolute before:inset-0 before:-z-10 before:bg-linear-to-b before:opacity-0 before:transition-opacity before:duration-500 before:ease-out-soft hover:before:opacity-100 focus-visible:before:opacity-100 motion-reduce:before:transition-none focus-visible:outline-white relative flex h-full flex-col overflow-clip px-8 py-15 focus-visible:outline-2 focus-visible:-outline-offset-2 lg:px-14 lg:py-21',
                  motion,
                ]}
              >
                <span
                  class:list={[
                    'pointer-fine:group-hover:-translate-y-2 pointer-fine:group-focus-visible:-translate-y-2 flex flex-col gap-1',
                    motion,
                  ]}
                >
                  <span
                    class:list={[
                      'text-stat text-frost group-hover:text-white group-focus-visible:text-white origin-bottom-left font-extralight pointer-fine:group-hover:scale-110 pointer-fine:group-focus-visible:scale-110',
                      motion,
                    ]}
                  >
                    <span class="reveal-line-mask block">
                      <span class="reveal-rise block">{value}</span>
                    </span>
                  </span>
                  <span class="reveal-fade">
                    <span
                      class:list={[
                        'text-stat-label leading-tight block text-sky group-hover:text-frost group-focus-visible:text-frost whitespace-pre-line',
                        motion,
                      ]}
                    >
                      {label}
                    </span>
                  </span>
                </span>
                <span
                  class:list={[
                    'text-frost hover:text-white absolute bottom-3 left-8 lg:left-14 text-link-sm font-medium pointer-fine:translate-y-4 pointer-fine:opacity-0 pointer-fine:group-hover:translate-y-0 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-visible:translate-y-0 pointer-fine:group-focus-visible:opacity-100',
                    motion,
                  ]}
                >
                  {linkLabel}
                </span>
                <span
                  aria-hidden="true"
                  class:list={[
                    'bg-signal absolute right-0 bottom-0 left-8 h-0.75 pointer-fine:translate-y-full pointer-fine:group-hover:translate-y-0 pointer-fine:group-focus-visible:translate-y-0 lg:left-14',
                    motion,
                  ]}
                ></span>
              </a>
              <span
                aria-hidden="true"
                class="border-line-dark pointer-events-none absolute top-0 -right-px bottom-0 left-0 z-10 border opacity-0 transition-opacity peer-hover:opacity-100 peer-focus-visible:opacity-100 motion-ui"
              ></span>
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </div>
</Section>

<script>
  import { initImageReveal } from '../../scripts/image-reveal';

  for (const root of document.querySelectorAll<HTMLElement>('[data-results]')) {
    initImageReveal(root, '0px');
  }
</script>
