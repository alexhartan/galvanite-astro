---
import { getCollection } from 'astro:content';
import CaseCard from '../ui/CaseCard.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import SectionFrame from '../ui/SectionFrame.astro';

interface Props {
  id?: string;
  label: string;
  sceneStart?: boolean;
  layout?: 'scroll' | 'marquee';
}
const {
  id = 'work',
  label,
  sceneStart = false,
  layout = 'scroll',
} = Astro.props;
const cases = (await getCollection('caseStudies')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  data-tone="light"
  data-scene-start={sceneStart ? '' : undefined}
  class="scroll-mt-nav relative z-10 overflow-x-clip bg-white"
>
  <SectionFrame edge={false} />
  <div
    data-guide
    class="border-ink/10 relative overflow-y-clip border-t pb-32 lg:pb-48"
  >
    <Container class="pt-12 lg:pt-16">
      <Eyebrow id={`${id}-label`}>{label}</Eyebrow>
    </Container>
    {layout === 'marquee' ? (
      <div data-case-marquee class="relative mt-8">
        <Container class="@container">
          <div class="clip-left">
            <div
              data-track
              class="flex w-max translate-x-(--x,0) gap-6 lg:gap-10"
            >
              {[false, true].map((copy) =>
                cases.map(({ data }, index) => (
                  <CaseCard
                    data={data}
                    index={index}
                    copy={copy}
                    class="w-slide sm:w-slide-sm lg:w-slide-lg"
                  />
                )),
              )}
            </div>
          </div>
        </Container>
      </div>
    ) : (
      <div data-case-scroll class="relative mt-8 h-(--scroll-height,auto)">
        <div data-sticky class="top-nav sticky">
          <Container>
            <div class="clip-left">
              <div data-track class="flex translate-x-(--x,0) gap-6 lg:gap-10">
                {cases.map(({ data }, index) => (
                  <CaseCard
                    data={data}
                    index={index}
                    bleed={index === cases.length - 1}
                    class="w-5/6 sm:w-3/5 lg:w-case"
                  />
                ))}
              </div>
            </div>
          </Container>
        </div>
      </div>
    )}
  </div>
</section>

<script>
  import { initCaseScroll } from '../../scripts/case-scroll';
  import { initImageReveal } from '../../scripts/image-reveal';
  import { initMarquee } from '../../scripts/marquee';
  import { initRotator } from '../../scripts/rotator';
  import { splitLines } from '../../scripts/split-lines';

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-case-scroll], [data-case-marquee]',
  )) {
    root
      .querySelectorAll<HTMLElement>('[data-split]')
      .forEach((el) => splitLines(el));
    root
      .querySelectorAll<HTMLElement>('[data-rotator]')
      .forEach((el) => initRotator(el));
    if (root.hasAttribute('data-case-marquee')) initMarquee(root);
    else initCaseScroll(root);
    initImageReveal(root);
  }
</script>
