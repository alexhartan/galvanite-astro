---
import { Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import ArrowIcon from '../ui/ArrowIcon.astro';
import Container from '../ui/Container.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import SparkIcon from '../ui/SparkIcon.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  id?: string;
  label: string;
}
const { id = 'work', label } = Astro.props;
const cases = (await getCollection('caseStudies')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  data-tone="light"
  class="scroll-mt-nav relative z-10 overflow-x-clip bg-white"
>
  <SectionFrame edge={false} />
  <div data-guide class="border-ink/10 relative border-t pb-32 lg:pb-48">
    <Container class="pt-12 lg:pt-16">
      <Eyebrow id={`${id}-label`}>{label}</Eyebrow>
    </Container>
    <div data-case-scroll class="relative mt-8 h-(--scroll-height,auto)">
      <div data-sticky class="top-nav sticky">
        <Container>
          <div class="clip-left">
            <div data-track class="flex translate-x-(--x,0) gap-6 lg:gap-10">
              {cases.map(({ data }, index) => {
                const Tag = data.href ? 'a' : 'div';
                return (
                  <article
                    data-slide
                    class="group w-5/6 shrink-0 sm:w-3/5 lg:w-case"
                  >
                    <Tag href={data.href} class="block">
                      <div class="relative overflow-hidden">
                        <div
                          class="reveal-mask"
                          style={`--delay: ${Math.min(index, 3) * 160}ms`}
                        >
                          <div class="reveal-zoom">
                            <Picture
                              src={data.image}
                              alt={data.imageAlt}
                              formats={['avif', 'webp']}
                              widths={[400, 600, 800, 1200]}
                              sizes="(min-width: 1024px) 40vw, (min-width: 640px) 60vw, 85vw"
                              quality={78}
                              draggable="false"
                              class="ease-out-soft 4xl:aspect-square aspect-4/3 w-full object-cover transition-transform duration-700 group-hover:scale-104"
                            />
                          </div>
                        </div>
                        <div
                          aria-hidden="true"
                          class="ease-in-soft absolute top-8 right-8 opacity-0 transition-opacity duration-300 group-hover:opacity-100 lg:top-10 lg:right-10"
                        >
                          <svg
                            viewBox="0 0 56 56"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="3"
                            class="ease-out-soft size-10 -translate-x-1/2 translate-y-1/2 text-white transition-transform duration-700 group-hover:translate-0 motion-reduce:translate-0 lg:size-14"
                          >
                            <path d="M2 54 54 2M14 2h40v40"></path>
                          </svg>
                        </div>
                      </div>
                      <p class="border-ink/10 text-ink/80 ease-out-soft flex items-center gap-2.5 border-b px-3 py-3.5 opacity-80 transition-opacity duration-300 group-hover:opacity-100">
                        <SparkIcon class="text-signal size-5 shrink-0" />
                        {data.stat}
                      </p>
                      <div>
                        <h4 class="text-card text-ink ease-out-soft mt-3 font-normal text-balance opacity-80 transition-opacity duration-300 group-hover:opacity-100">
                          {data.title}
                        </h4>
                        <ul
                          class="ease-out-soft mt-4 flex -translate-y-2 flex-wrap gap-2.25 opacity-0 transition duration-500 group-hover:translate-y-0 group-hover:opacity-100 motion-reduce:translate-y-0"
                          aria-label="Scope"
                        >
                          {data.scope.map((item) => (
                            <li class="bg-ocean-50 text-azure-deep text-tag rounded-sm px-2.5 py-1.25 font-medium tracking-wider uppercase">
                              {item}
                            </li>
                          ))}
                        </ul>
                        {data.href && (
                          <span class="text-ink border-ink mt-6 inline-flex items-center gap-2 border-b-2 pb-1 text-sm font-semibold">
                            Read the case study
                            <ArrowIcon />
                          </span>
                        )}
                      </div>
                    </Tag>
                  </article>
                );
              })}
            </div>
          </div>
        </Container>
      </div>
    </div>
  </div>
</section>

<script>
  import { initCaseScroll } from '../../scripts/case-scroll';
  import { initImageReveal } from '../../scripts/image-reveal';

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-case-scroll]',
  )) {
    initCaseScroll(root);
    initImageReveal(root);
  }
</script>
