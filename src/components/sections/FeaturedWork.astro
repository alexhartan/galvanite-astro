---
import { getCollection } from 'astro:content';
import CaseCard from '../ui/CaseCard.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import SectionFrame from '../ui/SectionFrame.astro';

interface Props {
  id?: string;
  label: string;
  sceneStart?: boolean;
}
const { id = 'work', label, sceneStart = false } = Astro.props;
const cases = (await getCollection('caseStudies')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Section id={id} data-scene-start={sceneStart ? '' : undefined}>
  <SectionFrame edge={false} />
  <div data-guide class="border-line relative border-t pb-72 lg:pb-154">
    <Container class="max-lg:pt-12">
      <Eyebrow id={`${id}-label`}>{label}</Eyebrow>
    </Container>
    <div
      data-case-marquee
      data-parallax="0.2"
      data-parallax-from="enter"
      class="translate-y-(--shift)"
    >
      <Container class="@container">
        <div class="clip-left">
          <div
            data-track
            class="flex w-max translate-x-(--x,0) cursor-grab touch-pan-y gap-12 select-none active:cursor-grabbing lg:gap-20"
          >
            {[false, true].map((copy) =>
              cases.map(({ data }, index) => (
                <CaseCard
                  data={data}
                  index={index}
                  copy={copy}
                  class="w-slide sm:w-slide-sm lg:w-slide-lg"
                />
              )),
            )}
          </div>
        </div>
      </Container>
    </div>
  </div>
</Section>

<script>
  import { initImageReveal } from '../../scripts/image-reveal';
  import { initMarquee } from '../../scripts/marquee';
  import '../../scripts/parallax';
  import { initRotator } from '../../scripts/rotator';
  import { splitLines } from '../../scripts/split-lines';

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-case-marquee]',
  )) {
    root
      .querySelectorAll<HTMLElement>('[data-split]')
      .forEach((el) => splitLines(el));
    root
      .querySelectorAll<HTMLElement>('[data-rotator]')
      .forEach((el) => initRotator(el));
    initMarquee(root);
    initImageReveal(root);
  }
</script>
