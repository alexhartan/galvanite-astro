---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import GridMark from '../ui/GridMark.astro';

interface Props {
  id?: string;
  heading: string;
  description: string;
  action?: string;
}
const { id = 'fit', heading, description, action = '#contact' } = Astro.props;
const checks = (await getCollection('checks')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  data-tone="light"
  class="scroll-mt-nav relative z-10 overflow-x-clip bg-white"
>
  <Container class="pointer-events-none absolute inset-0">
    <div class="bg-ink/10 absolute inset-y-0 left-6 w-px"></div>
    <div class="bg-ink/10 absolute inset-y-0 right-6 w-px"></div>
    <GridMark class="absolute top-0 left-6" />
    <GridMark class="absolute top-0 right-6 translate-x-1.25" />
  </Container>
  <div
    data-guide
    class="border-ink/10 from-navy/3 to-navy/0 relative border-t bg-linear-to-b"
  >
    <Container class="grid gap-12 py-40 lg:grid-cols-2 lg:items-center lg:gap-0 lg:py-56">
      <div>
        <h2
          id={`${id}-heading`}
          class="text-assess text-ocean font-normal whitespace-pre-line"
        >
          {heading}
        </h2>
        <p class="text-graphite/80 mt-10 max-w-sm text-base">{description}</p>
      </div>
      <form action={action} class="lg:p-5">
        <fieldset>
          <legend class="sr-only">Select the issues that ring true</legend>
          <ul class="grid gap-5 sm:grid-cols-2" role="list">
            {checks.map(({ id: key, data }) => (
              <li>
                <label class="group border-midnight/15 hover:border-glacier/50 hover:bg-white has-checked:border-glacier has-checked:bg-glacier-tint ease-out-soft flex h-full cursor-pointer items-center gap-4 rounded-lg border bg-white px-4 py-5 transition-colors duration-300">
                  <span class="relative flex size-6 shrink-0">
                    <input
                      type="checkbox"
                      name="issues"
                      value={key}
                      class="peer border-midnight/15 group-hover:border-glacier checked:border-glacier focus-visible:outline-ocean ease-out-soft size-6 cursor-pointer appearance-none rounded-sm border-2 bg-white transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2"
                    />
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="text-azure-deep pointer-events-none absolute inset-0"
                    >
                      <path
                        d="M6 12.5l4 4 8-9"
                        pathLength="1"
                        class="dash-hidden group-has-checked:dash-shown"
                      />
                    </svg>
                  </span>
                  <span class="text-ocean text-base leading-tight font-medium italic">
                    {data.statement}
                  </span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
        <div class="border-midnight/15 hover:border-sky/50 focus-within:border-sky ease-out-soft mt-5 flex flex-col gap-1.5 rounded-lg border bg-white p-1.5 transition-colors duration-300 sm:flex-row">
          <label for={`${id}-url`} class="sr-only">
            Company website
          </label>
          <input
            id={`${id}-url`}
            type="url"
            name="website"
            required
            autocomplete="url"
            inputmode="url"
            placeholder="yourwebsite.com"
            class="text-ocean placeholder:text-ocean/33 min-h-11 min-w-0 flex-1 bg-transparent px-3 text-xl font-normal outline-none"
          />
          <button
            type="submit"
            class="bg-signal text-ink focus-visible:outline-ocean ease-out-soft min-h-11 cursor-pointer px-12 text-sm font-semibold transition-opacity duration-300 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            Get the Report
          </button>
        </div>
      </form>
    </Container>
  </div>
</section>
