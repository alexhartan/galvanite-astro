---
import { getCollection } from 'astro:content';
import Checkbox from '../ui/Checkbox.astro';
import Container from '../ui/Container.astro';
import InlineField from '../ui/InlineField.astro';
import ReportDialog from '../ui/ReportDialog.astro';
import Section from '../ui/Section.astro';
import SectionFrame from '../ui/SectionFrame.astro';

interface Props {
  id?: string;
  heading: string;
  description: string;
  action?: string;
}
const { id = 'fit', heading, description, action = '#contact' } = Astro.props;
const checks = (await getCollection('checks')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Section id={id} labelledby={`${id}-heading`}>
  <SectionFrame edge="always" />
  <div
    data-guide
    class="border-line from-tint to-transparent relative border-t bg-linear-to-b"
  >
    <Container class="pt-20 pb-30 lg:pt-28 lg:pb-42">
      <div class="mx-auto w-full lg:w-2/3 xl:w-1/2">
        <div class="text-center">
          <h2 id={`${id}-heading`} class="text-assess text-ocean font-normal">
            {heading}
          </h2>
          <p class="text-graphite/80 mt-3 text-base text-balance">
            {description}
          </p>
        </div>
        <form action={action} novalidate data-assess class="mt-8">
          <fieldset aria-describedby={`${id}-issues-error`}>
            <legend class="sr-only">Select the issues that ring true</legend>
            <ul class="grid gap-3 sm:grid-cols-2" role="list">
              {checks.map(({ id: key, data }) => (
                <li>
                  <label class="group border-line-control hover:border-glacier has-checked:border-glacier has-checked:bg-glacier-tint issues-error:border-alert/60 rounded-surface motion-ui flex h-full cursor-pointer items-center gap-4 border bg-white px-4 py-5 transition-colors hover:bg-white">
                    <Checkbox name="issues" value={key} />
                    <span
                      data-statement
                      class="text-ocean text-base leading-tight font-medium text-balance italic"
                    >
                      {data.statement}
                    </span>
                  </label>
                </li>
              ))}
            </ul>
            <p
              id={`${id}-issues-error`}
              data-issues-message
              hidden
              class="text-alert mt-3 text-sm"
            >
              Please select at least one item from the list
            </p>
          </fieldset>
          <div class="mt-5">
            <InlineField
              id={`${id}-url`}
              name="website"
              label="Company website"
              placeholder="yourwebsite.com"
              autocomplete="url"
              inputmode="url"
              describedby={`${id}-url-error`}
              action="Get the Report"
            />
          </div>
          <p
            id={`${id}-url-error`}
            data-url-message
            hidden
            class="text-alert mt-2 text-sm"
          >
            Please enter a valid website URL
          </p>
        </form>
      </div>
    </Container>
    <ReportDialog id={`${id}-report`} action={action} />
  </div>
</Section>

<script>
  import { initAssess } from '../../scripts/assess';

  for (const form of document.querySelectorAll<HTMLFormElement>(
    '[data-assess]',
  )) {
    const dialog = form
      .closest('section')
      ?.querySelector<HTMLDialogElement>('[data-report-dialog]');
    initAssess(form, dialog ?? null);
  }
</script>
