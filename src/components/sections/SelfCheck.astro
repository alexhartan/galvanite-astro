---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import GridMark from '../ui/GridMark.astro';

interface Props {
  id?: string;
  heading: string;
  description: string;
  action?: string;
}
const { id = 'fit', heading, description, action = '#contact' } = Astro.props;
const checks = (await getCollection('checks')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  data-tone="light"
  class="scroll-mt-nav relative z-10 overflow-x-clip bg-white"
>
  <Container class="pointer-events-none absolute inset-0">
    <div class="bg-line absolute inset-y-0 left-gutter w-px"></div>
    <div class="bg-line absolute inset-y-0 right-gutter w-px"></div>
    <GridMark class="absolute top-0 left-gutter" />
    <GridMark class="absolute top-0 right-gutter translate-x-1.25" />
  </Container>
  <div
    data-guide
    class="border-line from-tint to-transparent relative border-t bg-linear-to-b"
  >
    <Container class="grid gap-12 pt-20 pb-30 lg:grid-cols-2 lg:items-start lg:gap-0 lg:pt-28 lg:pb-42">
      <div>
        <h2
          id={`${id}-heading`}
          class="text-assess text-ocean font-normal whitespace-pre-line"
        >
          {heading}
        </h2>
        <p class="text-graphite/80 mt-3 max-w-sm text-base">{description}</p>
      </div>
      <form action={action} novalidate data-assess class="lg:px-5">
        <fieldset aria-describedby={`${id}-issues-error`}>
          <legend class="sr-only">Select the issues that ring true</legend>
          <ul class="grid gap-3 sm:grid-cols-2" role="list">
            {checks.map(({ id: key, data }) => (
              <li>
                <label class="group border-line-control hover:border-glacier hover:bg-white has-checked:border-glacier has-checked:bg-glacier-tint issues-error:border-alert/60 ease-out-soft flex h-full cursor-pointer items-center gap-4 rounded-surface border bg-white px-4 py-5 transition-colors duration-300">
                  <span class="relative flex size-6 shrink-0">
                    <input
                      type="checkbox"
                      name="issues"
                      value={key}
                      class="peer border-line-control group-hover:border-glacier checked:border-glacier focus-visible:outline-ocean ease-out-soft size-6 cursor-pointer appearance-none rounded-control border-2 bg-white transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2"
                    />
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="text-azure-deep pointer-events-none absolute inset-0"
                    >
                      <path
                        d="M6 12.5l4 4 8-9"
                        pathLength="1"
                        class="dash-hidden group-has-checked:dash-shown"
                      />
                    </svg>
                  </span>
                  <span class="text-ocean text-base leading-tight font-medium text-balance italic">
                    {data.statement}
                  </span>
                </label>
              </li>
            ))}
          </ul>
          <p
            id={`${id}-issues-error`}
            data-issues-message
            hidden
            class="text-alert mt-3 text-sm"
          >
            Please select at least one item from the list
          </p>
        </fieldset>
        <div class="border-line-control hover:border-sky/50 focus-within:border-sky field-error:border-alert/60 ease-out-soft mt-5 flex flex-col gap-1.5 rounded-surface border bg-white p-1.5 transition-colors duration-300 sm:flex-row">
          <label for={`${id}-url`} class="sr-only">
            Company website
          </label>
          <input
            id={`${id}-url`}
            type="text"
            name="website"
            required
            aria-describedby={`${id}-url-error`}
            autocomplete="url"
            inputmode="url"
            placeholder="yourwebsite.com"
            class="text-ocean placeholder:text-ocean/33 min-h-11 min-w-0 flex-1 bg-transparent px-2.5 text-2xl font-normal outline-none"
          />
          <button
            type="submit"
            class="bg-signal text-ink focus-visible:outline-ocean ease-out-soft min-h-11 cursor-pointer px-12 text-sm font-semibold transition-opacity duration-300 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            Get the Report
          </button>
        </div>
        <p
          id={`${id}-url-error`}
          data-url-message
          hidden
          class="text-alert mt-2 text-sm"
        >
          Please enter a valid website URL
        </p>
      </form>
    </Container>
  </div>
</section>

<script>
  import { initAssess } from '../../scripts/assess';

  for (const form of document.querySelectorAll<HTMLFormElement>(
    '[data-assess]',
  )) {
    initAssess(form);
  }
</script>
