---
import Container from '../ui/Container.astro';
import GridMark from '../ui/GridMark.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  ctaHref?: string;
}
const { ctaHref = '#contact' } = Astro.props;
---

<header
  data-nav
  class="group pointer-events-none fixed inset-x-0 top-0 z-30 h-nav ease-out-soft border-b border-white/10 transition-colors duration-300 data-light:border-ink/10 pt-5.5"
>
  <div
    aria-hidden="true"
    class="from-space-950 to-space-900 absolute inset-0 -z-10 bg-linear-to-br bg-fixed"
  >
    <canvas
      data-nav-window
      class="ease-out-soft size-full opacity-0 transition-opacity duration-700 data-ready:opacity-100"
    ></canvas>
  </div>
  <div
    aria-hidden="true"
    class="ease-out-soft absolute inset-0 -z-10 bg-white opacity-0 transition-opacity duration-300 group-data-light:opacity-100"
  ></div>
  <Container class="relative h-full">
    <a
      href={import.meta.env.BASE_URL}
      aria-label="Galvanite home"
      data-nav-logo
      class="pointer-events-auto -m-0.5 inline-flex size-11 items-center justify-center text-white transition-colors duration-300 ease-out-soft group-data-light:text-ink focus-visible:outline-current rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      <Logo />
    </a>
    <a
      href={ctaHref}
      class="bg-signal hover:bg-signal-strong ease-out-soft focus-visible:outline-grid pointer-events-auto absolute top-0 right-6 -mt-0.5 inline-flex h-11 items-center px-5 text-ink text-sm font-semibold transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      Book a Call
    </a>
    <GridMark
      inverted
      class="ease-out-soft group-data-light:text-ink/30 absolute top-full left-6 transition-colors duration-300"
    />
  </Container>
</header>

<script>
  import { initNavTone } from '../../scripts/nav-tone';

  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) initNavTone(nav);
</script>
