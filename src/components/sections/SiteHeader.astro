---
import CtaButton from '../ui/CtaButton.astro';
import Container from '../ui/Container.astro';
import GridMark from '../ui/GridMark.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  ctaHref?: string;
}
const { ctaHref = '#contact' } = Astro.props;
---

<header
  data-nav
  class="group pointer-events-none fixed inset-x-0 top-0 z-30 h-nav border-b border-line-dark transition-colors data-light:border-line pt-5.5 motion-ui"
>
  <div
    aria-hidden="true"
    class="from-space-950 to-space-900 absolute inset-0 -z-10 bg-linear-to-br bg-fixed"
  >
    <canvas
      data-nav-window
      class="ease-out-soft size-full opacity-0 transition-opacity duration-700 data-ready:opacity-100"
    ></canvas>
  </div>
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-white opacity-0 transition-opacity group-data-light:opacity-100 motion-ui"
  ></div>
  <Container class="relative h-full">
    <a
      href={import.meta.env.BASE_URL}
      aria-label="Galvanite home"
      data-nav-logo
      class="pointer-events-auto -m-0.5 inline-flex lg:-translate-x-10 size-11 items-center justify-center text-white transition-colors group-data-light:text-ink focus-visible:outline-current rounded-surface motion-ui focus-ring"
    >
      <Logo />
    </a>
    <CtaButton
      href={ctaHref}
      class="pointer-events-auto absolute top-0 right-gutter -mt-0.5"
      link="h-11 px-5 text-sm"
    >
      Book a Call
    </CtaButton>
    <GridMark
      inverted
      class="group-data-light:text-ink/30 absolute top-full left-gutter transition-colors motion-ui"
    />
  </Container>
</header>

<script>
  import { initNavTone } from '../../scripts/nav-tone';

  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) initNavTone(nav);
</script>
