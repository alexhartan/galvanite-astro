---
import Container from '../ui/Container.astro';
import GridMark from '../ui/GridMark.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  ctaHref?: string;
}
const { ctaHref = '#contact' } = Astro.props;
---

<header class="pointer-events-none fixed inset-x-0 top-0 z-30 h-nav border-b border-grid/10 pt-5.5">
  <div class="absolute inset-0 -z-10 bg-white opacity-(--grid-invert,0)"></div>
  <Container class="relative h-full">
    <a
      href={import.meta.env.BASE_URL}
      aria-label="Galvanite home"
      class="pointer-events-auto -m-0.5 inline-flex size-11 items-center justify-center text-grid focus-visible:outline-grid rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      <Logo />
    </a>
    <a
      href={ctaHref}
      class="bg-signal hover:bg-signal-strong ease-out-soft focus-visible:outline-grid pointer-events-auto absolute top-0 right-6 -mt-0.5 inline-flex h-11 items-center rounded-sm px-5 text-ink text-sm font-semibold transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2"
    >
      Book a Call
    </a>
    <GridMark class="absolute top-full left-6" />
  </Container>
</header>
