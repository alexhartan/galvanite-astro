---
import CtaButton from '../ui/CtaButton.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import ArrowIcon from '../ui/ArrowIcon.astro';
import Container from '../ui/Container.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import GridMark from '../ui/GridMark.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
  stats?: { value: string; label: string }[];
}
const { id = 'testimonials', label, heading, stats = [] } = Astro.props;
const right = '3xl:block lg:hidden';
const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order,
);
const pages = Array.from(
  { length: Math.ceil(testimonials.length / 2) },
  (_, index) => testimonials.slice(index * 2, index * 2 + 2),
);
const icon =
  'opacity-80 transition-opacity duration-200 ease-out-soft group-hover:opacity-100';
const arrow =
  'group relative flex size-8 cursor-pointer items-center justify-center border border-white/10 text-sky before:absolute before:-inset-1.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class:list={[
    'scroll-mt-nav relative z-10 overflow-x-clip text-white',
    stats.length > 0 && 'pb-40 lg:pb-56',
  ]}
>
  <SectionFrame inverted />
  <div data-guide class="relative border-t border-white/10">
    <Container class="@container">
      <Eyebrow id={`${id}-label`} inverted>
        {label}
      </Eyebrow>
      <div
        data-testimonials
        role="region"
        aria-roledescription="carousel"
        aria-label="Testimonials"
      >
        <div class="mt-40 flex items-end justify-between gap-6 pb-6 lg:mt-56">
          <h3 class="text-section">{heading}</h3>
          <div class="-mb-6 flex shrink-0">
            <button
              type="button"
              data-prev
              aria-label="Previous testimonial"
              class={arrow}
            >
              <ArrowIcon class:list={[icon, 'rotate-180']} />
            </button>
            <button
              type="button"
              data-next
              aria-label="Next testimonial"
              class:list={[arrow, '-ml-px']}
            >
              <ArrowIcon class={icon} />
            </button>
          </div>
        </div>
        <div
          class:list={[
            'relative border-t border-white/10',
            stats.length === 0 && 'pb-48 lg:pb-56',
          ]}
        >
          <GridMark inverted class="absolute top-0 left-0 -mt-px" />
          <div class="grid touch-pan-y select-none">
            {pages.map((page, index) => (
              <div
                data-page
                data-active={index === 0 ? '' : undefined}
                inert={index !== 0}
                role="group"
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${pages.length}`}
                class="ease-out-soft invisible col-start-1 row-start-1 grid opacity-0 transition-[opacity,visibility] duration-700 data-active:visible data-active:opacity-100 lg:grid-cols-2"
              >
                {page.map(({ data }) => (
                  <figure class="group ease-out-soft pt-12 pr-10 transition-opacity duration-300 pointer-fine:opacity-90 pointer-fine:hover:opacity-100 lg:pr-16">
                    <blockquote class="text-frost text-lg font-extralight text-balance">
                      <p>{data.quote}</p>
                    </blockquote>
                    <figcaption class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-6">
                      <Image
                        src={data.photo}
                        alt=""
                        width={44}
                        height={44}
                        densities={[1, 2]}
                        format="webp"
                        class="size-11 object-cover"
                      />
                      <div class="flex-1">
                        <p class="text-sm font-semibold tracking-wider uppercase">
                          {data.name}
                        </p>
                        <p class="text-azure text-tag mt-1 tracking-wider uppercase">
                          {data.role}
                        </p>
                      </div>
                      {data.caseStudyHref && (
                        <CtaButton
                          href={data.caseStudyHref}
                          variant="secondary"
                          link="h-11 px-8 text-sm"
                          class="ease-out-soft relative transition-opacity duration-300 lg:opacity-0 lg:group-focus-within:opacity-100 lg:group-hover:opacity-100"
                        >
                          Read Case Study
                        </CtaButton>
                      )}
                    </figcaption>
                  </figure>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
      {stats.length > 0 && (
        <dl class="from-abyss/0 to-abyss relative grid gap-10 bg-linear-to-b px-8 pt-72 pb-24 sm:grid-cols-3 lg:pt-64 lg:pb-24">
          <div class="bleed-x absolute bottom-0 h-px bg-white/10"></div>
          <GridMark inverted class="absolute top-full left-0 -mt-px" />
          <GridMark
            inverted
            class:list={[right, 'absolute top-full left-full -mt-px -ml-px']}
          />
          {stats.map(({ value, label }) => (
            <div class="flex flex-col-reverse gap-2 sm:justify-self-center">
              <dt class="text-sky text-stat-label max-w-48">{label}</dt>
              <dd class="text-stat font-light">{value}</dd>
            </div>
          ))}
        </dl>
      )}
    </Container>
  </div>
</section>

<script>
  import { initTestimonials } from '../../scripts/testimonials';

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-testimonials]',
  )) {
    initTestimonials(root);
  }
</script>
