---
import CtaButton from '../ui/CtaButton.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import ArrowIcon from '../ui/ArrowIcon.astro';
import Container from '../ui/Container.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import GridMark from '../ui/GridMark.astro';
import LogoMarquee from '../ui/LogoMarquee.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
}
const { id = 'testimonials', label, heading } = Astro.props;
const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order,
);
const pages = Array.from(
  { length: Math.ceil(testimonials.length / 2) },
  (_, index) => testimonials.slice(index * 2, index * 2 + 2),
);
const icon =
  'opacity-80 transition-opacity duration-200 ease-out-soft group-hover:opacity-100';
const arrow =
  'group relative flex size-8 cursor-pointer items-center justify-center border border-line-dark text-sky before:absolute before:-inset-1.5 focus-visible:outline-white focus-ring';
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class="scroll-mt-nav relative z-10 overflow-x-clip pt-section text-white"
>
  <SectionFrame inverted top={false} />
  <div data-testimonials>
    <Container class="flex items-end justify-between gap-6 pb-6">
      <h2 class="text-section">{heading}</h2>
      <div class="relative z-10 -mb-6 flex shrink-0">
        <button
          type="button"
          data-prev
          aria-label="Previous testimonial"
          class={arrow}
        >
          <ArrowIcon class:list={[icon, 'rotate-180']} />
        </button>
        <button
          type="button"
          data-next
          aria-label="Next testimonial"
          class:list={[arrow, '-ml-px']}
        >
          <ArrowIcon class={icon} />
        </button>
      </div>
    </Container>
    <div data-guide class="relative border-t border-line-dark">
      <Container class="pointer-events-none absolute inset-0">
        <GridMark inverted class="absolute top-0 left-gutter" />
      </Container>
      <Container class="@container">
        <Eyebrow id={`${id}-label`} inverted>
          {label}
        </Eyebrow>
        <div
          role="region"
          aria-roledescription="carousel"
          aria-label="Testimonials"
        >
          <div class="grid touch-pan-y select-none">
            {pages.map((page, index) => (
              <div
                data-page
                data-active={index === 0 ? '' : undefined}
                inert={index !== 0}
                role="group"
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${pages.length}`}
                class="ease-out-soft invisible col-start-1 row-start-1 grid opacity-0 transition-[opacity,visibility] duration-700 data-active:visible data-active:opacity-100 lg:grid-cols-2"
              >
                {page.map(({ data }) => (
                  <figure class="group pt-12 pr-10 transition-opacity pointer-fine:opacity-90 pointer-fine:hover:opacity-100 lg:pr-16 motion-ui">
                    <blockquote class="text-frost text-lg font-extralight text-balance">
                      <p>{data.quote}</p>
                    </blockquote>
                    <figcaption class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-6">
                      <Image
                        src={data.photo}
                        alt=""
                        width={44}
                        height={44}
                        densities={[1, 2]}
                        format="webp"
                        class="size-11 object-cover"
                      />
                      <div class="flex-1">
                        <p class="text-sm font-semibold tracking-wider uppercase">
                          {data.name}
                        </p>
                        <p class="text-sky text-2xs mt-1 tracking-wider uppercase">
                          {data.role}
                        </p>
                      </div>
                      {data.caseStudyHref && (
                        <CtaButton
                          href={data.caseStudyHref}
                          variant="secondary"
                          link="h-11 px-8 text-sm"
                          class="relative transition-opacity motion-ui reveal-on-hover"
                        >
                          Read Case Study
                        </CtaButton>
                      )}
                    </figcaption>
                  </figure>
                ))}
              </div>
            ))}
          </div>
        </div>
        <div class="mt-12 pb-48 opacity-70 lg:mt-16 lg:pb-56">
          <LogoMarquee class="mask-fade-x overflow-clip" large />
        </div>
      </Container>
    </div>
  </div>
</section>

<script>
  import { initTestimonials } from '../../scripts/testimonials';

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-testimonials]',
  )) {
    initTestimonials(root);
  }
</script>
