---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import LogoMarquee from '../ui/LogoMarquee.astro';
import SectionFrame from '../ui/SectionFrame.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
}
const { id = 'testimonials', label, heading } = Astro.props;
const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order,
);
const total = testimonials.length;
const position = (index: number) =>
  index === 0
    ? 'active'
    : index === 1
      ? 'next'
      : index === total - 1
        ? 'prev'
        : 'hidden';
const side = (index: number) => ['prev', 'next'].includes(position(index));
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class="scroll-mt-nav relative z-10 overflow-x-clip pb-40 text-white lg:pb-56"
>
  <SectionFrame inverted />
  <div data-guide class="relative border-t border-white/10">
    <Container>
      <Eyebrow id={`${id}-label`} inverted>
        {label}
      </Eyebrow>
      <h3 class="text-section mt-40 text-center lg:mt-56">{heading}</h3>
      <div
        data-testimonials
        role="region"
        aria-roledescription="carousel"
        aria-label="Testimonials"
        class="mt-14 grid touch-pan-y justify-items-center select-none"
      >
        {testimonials.map(({ data }, index) => (
          <figure
            data-card
            data-pos={position(index)}
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${total}`}
            inert={position(index) === 'hidden'}
            class="card-edge ease-out-soft card-active:z-20 card-side:z-10 card-side:scale-80 card-side:opacity-60 card-next:translate-x-1/5 card-prev:-translate-x-1/5 card-hidden:scale-60 card-hidden:opacity-0 relative col-start-1 row-start-1 w-full max-w-2xl self-center transition duration-700 motion-reduce:transition-none"
          >
            <div
              aria-hidden="true"
              class="bg-signal in-card-side:opacity-0 absolute inset-x-0 -top-px h-1 transition-opacity duration-700"
            />
            <div
              data-content
              inert={index !== 0}
              class="ease-out-soft in-card-side:opacity-0 px-8 pt-14 pb-12 transition-opacity duration-700 sm:px-14"
            >
              <blockquote class="text-frost text-lg font-extralight text-balance">
                <p>{data.quote}</p>
              </blockquote>
              <figcaption class="mt-12 flex items-center gap-4">
                <Image
                  src={data.photo}
                  alt=""
                  width={36}
                  height={36}
                  densities={[1, 2]}
                  format="webp"
                  class="size-9 object-cover"
                />
                <div>
                  <p class="text-sm font-semibold tracking-wider uppercase">
                    {data.name}
                  </p>
                  <p class="text-sky text-tag mt-1 tracking-wider uppercase">
                    {data.role}
                  </p>
                </div>
              </figcaption>
            </div>
            <button
              type="button"
              data-go
              hidden={!side(index)}
              aria-label={
                position(index) === 'prev'
                  ? 'Previous testimonial'
                  : 'Next testimonial'
              }
              class="absolute inset-0 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            />
          </figure>
        ))}
      </div>
      <div class="mt-16 opacity-70">
        <LogoMarquee class="mask-fade-x overflow-clip" />
      </div>
    </Container>
  </div>
</section>

<script>
  import { initTestimonials } from '../../scripts/testimonials';

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-testimonials]',
  )) {
    initTestimonials(root);
  }
</script>
