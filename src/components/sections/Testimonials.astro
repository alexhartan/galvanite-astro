---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import ArrowIcon from '../ui/ArrowIcon.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import GridMark from '../ui/GridMark.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
}
const { id = 'testimonials', label, heading } = Astro.props;
const testimonials = (await getCollection('testimonials')).sort(
  (a, b) => a.data.order - b.data.order,
);
const pages = Array.from(
  { length: Math.ceil(testimonials.length / 2) },
  (_, index) => testimonials.slice(index * 2, index * 2 + 2),
);
const right = '3xl:block lg:hidden';
const icon =
  'opacity-80 transition-opacity duration-200 ease-out-soft group-hover:opacity-100';
const arrow =
  'group relative flex size-8 cursor-pointer items-center justify-center border border-white/10 text-sky before:absolute before:-inset-1.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white';
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class="scroll-mt-nav relative z-10 overflow-hidden text-white"
>
  <Container class="absolute inset-0">
    <div class="absolute inset-y-0 left-6 w-px bg-white/10"></div>
    <div
      class:list={[right, 'absolute inset-y-0 right-6 w-px bg-white/10']}
    ></div>
  </Container>
  <div data-guide class="relative border-t border-white/10">
    <Container class="absolute inset-x-0 top-0">
      <GridMark inverted class="absolute top-0 left-6 -mt-px" />
      <div class:list={[right, 'absolute top-0 right-6 w-0']}>
        <GridMark inverted class="-mt-px" />
      </div>
    </Container>
    <Container class="@container">
      <Eyebrow id={`${id}-label`} inverted>
        {label}
      </Eyebrow>
      <div
        data-testimonials
        role="region"
        aria-roledescription="carousel"
        aria-label="Testimonials"
      >
        <div class="mt-40 flex items-end justify-between gap-6 pb-6 lg:mt-56">
          <h3 class="text-kpi-lg font-light">{heading}</h3>
          <div class="-mb-6 flex shrink-0">
            <button
              type="button"
              data-prev
              aria-label="Previous testimonial"
              class={arrow}
            >
              <ArrowIcon class:list={[icon, 'rotate-180']} />
            </button>
            <button
              type="button"
              data-next
              aria-label="Next testimonial"
              class:list={[arrow, '-ml-px']}
            >
              <ArrowIcon class={icon} />
            </button>
          </div>
        </div>
        <div class="relative border-t border-white/10 pb-40 lg:pb-48">
          <GridMark inverted class="absolute top-0 left-0 -mt-px" />
          <div class="absolute top-0 bottom-0 left-1/2 w-px bg-white/10 max-lg:hidden"></div>
          <GridMark
            inverted
            class="absolute top-0 left-1/2 -mt-px max-lg:hidden"
          />
          <div class="grid">
            {pages.map((page, index) => (
              <div
                data-page
                data-active={index === 0 ? '' : undefined}
                inert={index !== 0}
                role="group"
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${pages.length}`}
                class="ease-out-soft invisible col-start-1 row-start-1 grid opacity-0 transition-[opacity,visibility] duration-700 data-active:visible data-active:opacity-100 lg:grid-cols-2"
              >
                {page.map(({ data }) => (
                  <figure class="group pt-12 pr-10 lg:pr-16">
                    <blockquote class="text-frost text-xl font-light">
                      <p>{data.quote}</p>
                    </blockquote>
                    <figcaption class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-6">
                      <Image
                        src={data.photo}
                        alt=""
                        width={44}
                        height={44}
                        densities={[1, 2]}
                        format="webp"
                        class="size-11 object-cover"
                      />
                      <div class="flex-1">
                        <p class="text-sm font-semibold tracking-widest uppercase">
                          {data.name}
                        </p>
                        <p class="text-azure text-label mt-1 tracking-widest uppercase">
                          {data.role}
                        </p>
                      </div>
                      {data.caseStudyHref && (
                        <a
                          href={data.caseStudyHref}
                          class="bg-ink/60 hover:bg-ink ease-out-soft flex h-11 items-center rounded-sm px-8 text-sm font-semibold transition-[opacity,background-color] duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:opacity-0 lg:group-focus-within:opacity-100 lg:group-hover:opacity-100"
                        >
                          Read Case Study
                        </a>
                      )}
                    </figcaption>
                  </figure>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </div>
</section>

<script>
  import { initTestimonials } from '../../scripts/testimonials';

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-testimonials]',
  )) {
    initTestimonials(root);
  }
</script>
