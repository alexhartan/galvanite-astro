---
import { Image } from 'astro:assets';
import logos from '../../assets/logos-placeholder.png';
import Container from '../ui/Container.astro';
import GridMark from '../ui/GridMark.astro';

interface Props {
  lead: string;
  emphasis: string;
  description: string;
}
const { lead, emphasis, description } = Astro.props;
---

<section
  data-hero
  class="from-space-950 to-space-900 fixed inset-0 bg-linear-to-br"
>
  <div class="h-full overflow-hidden">
    <canvas
      data-hero-canvas
      aria-hidden="true"
      class="ease-out-soft absolute inset-0 size-full opacity-0 transition-opacity duration-700 data-ready:opacity-100"
    ></canvas>
    <Container class="absolute inset-0">
      <div class="absolute top-25 bottom-0 left-6 bg-grid/10 w-px"></div>
    </Container>
    <div class="relative flex h-full flex-col">
      <Container class="@container flex flex-1 flex-col justify-center pt-56">
        <h1 class="max-w-headline text-display lg:text-display-half font-extralight text-white">
          {lead} <strong class="font-semibold">{emphasis}</strong>
        </h1>
        <p class="max-w-lead text-lead mt-6 text-white/85">{description}</p>
      </Container>
      <div class="border-grid/10 border-t">
        <Container class="relative py-2.5">
          <GridMark class="absolute top-0 left-6" />
          <Image
            src={logos}
            alt="Clients: QuotientAI, Selfpay, SQLMesh, SweePay, Tobiko, Common Sense and Lumen Stream"
            class="ml-7.5 h-30 w-auto max-w-none opacity-80"
          />
        </Container>
      </div>
    </div>
  </div>
</section>
<div aria-hidden="true" class="h-svh"></div>

<script>
  import { initHeroScene } from '../../scripts/hero-scene';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  if (canvas) initHeroScene(canvas);
</script>
