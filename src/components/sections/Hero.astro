---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import GridMark from '../ui/GridMark.astro';

interface Props {
  eyebrow: string;
  lead: string;
  emphasis: string;
  description: string;
}
const { eyebrow, lead, emphasis, description } = Astro.props;
const clients = (
  await getCollection('clients', ({ data }) => !data.hidden)
).sort((a, b) => a.data.order - b.data.order);
---

<section
  data-hero
  class="group from-space-950 to-space-900 fixed inset-0 bg-linear-to-br"
>
  <div class="h-full overflow-hidden">
    <canvas
      data-hero-canvas
      aria-hidden="true"
      class="ease-out-soft absolute inset-0 size-full opacity-0 transition-opacity duration-700 data-ready:opacity-100"
    ></canvas>
    <Container class="pointer-events-none absolute inset-0 z-10 group-data-scene:invisible">
      <div class="absolute top-nav bottom-0 left-6 bg-grid/10 w-px"></div>
    </Container>
    <div
      data-hero-content
      class="relative flex h-full translate-y-(--shift) flex-col group-data-scene:invisible"
    >
      <Container class="@container pt-nav flex flex-1 flex-col justify-center max-lg:pt-56 lg:pb-4">
        <p class="text-sky mb-3.5 text-xs font-semibold tracking-widest uppercase lg:mb-4">
          {eyebrow}
        </p>
        <h1 class="max-w-headline text-display lg:text-display-half 4xl:text-display-hero relative font-extralight text-white">
          {lead} <strong class="font-semibold">{emphasis}</strong>
          <GridMark class="top-display-baseline 4xl:hidden absolute left-0" />
        </h1>
        <p class="max-w-lead text-lead lg:max-w-lead-hero lg:text-lead-hero 4xl:text-lead-hero-xl mt-6 text-white/85 lg:mt-4.5">
          {description}
        </p>
      </Container>
      <div class="relative overflow-x-clip">
        <Container class="pointer-events-none absolute inset-0">
          <div class="backdrop-blur-bar 3xl:-right-page-bleed absolute inset-y-0 right-0 left-6"></div>
          <div class="border-grid/5 bg-space-950/50 3xl:-right-page-bleed absolute inset-y-0 right-0 left-6 border-t"></div>
        </Container>
        <div class="relative opacity-50 pt-3.75 pb-6">
          <Container class="relative">
            <GridMark class="absolute -top-3.75 left-6 -mt-px" />
            <p class="text-frost text-xs font-normal tracking-widest uppercase">
              Trusted by technical teams at:
            </p>
            <div class="clip-left mt-1" aria-label="Clients" role="group">
              <div class="motion-safe:animate-marquee flex w-max">
                {[0, 1].map((copy) => (
                  <ul
                    class="flex shrink-0 items-center gap-10 pr-10"
                    aria-hidden={copy === 1 ? 'true' : undefined}
                  >
                    {clients.map(({ data }) => (
                      <li class="shrink-0">
                        <Image
                          src={data.logo}
                          alt={copy === 0 ? data.name : ''}
                          height={80}
                          densities={[1, 2]}
                          class="h-20 w-auto"
                        />
                      </li>
                    ))}
                  </ul>
                ))}
              </div>
            </div>
          </Container>
        </div>
      </div>
    </div>
  </div>
</section>
<div aria-hidden="true" class="h-svh"></div>

<script>
  import { initHeroScene } from '../../scripts/hero-scene';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  if (canvas)
    initHeroScene(
      canvas,
      document.querySelector<HTMLCanvasElement>('[data-nav-window]'),
    );
</script>
