---
import Container from '../ui/Container.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import LogoMarquee from '../ui/LogoMarquee.astro';

interface Props {
  eyebrow: string;
  lead: string;
  emphasis: string;
  description: string;
  logos?: boolean;
  steps?: boolean;
}
const {
  eyebrow,
  lead,
  emphasis,
  description,
  logos = true,
  steps = false,
} = Astro.props;
---

<section
  data-hero
  data-scene-steps={steps ? '' : undefined}
  class="group from-space-950 to-space-900 fixed inset-0 bg-linear-to-br"
>
  <div class="h-full overflow-hidden">
    <canvas
      data-hero-canvas
      aria-hidden="true"
      class="ease-out-soft absolute inset-0 size-full opacity-0 transition-opacity duration-700 data-ready:opacity-100"
    ></canvas>
    <Container class="pointer-events-none absolute inset-0 z-10 group-data-scene:invisible">
      <div class="absolute top-nav bottom-0 left-gutter bg-grid/10 w-px"></div>
    </Container>
    <div
      data-hero-content
      class="relative flex h-full translate-y-(--shift) flex-col group-data-scene:invisible"
    >
      <Container class="@container pt-nav flex flex-1 flex-col justify-center max-lg:pt-56 lg:pb-4">
        <p class="text-sky mb-3.5 text-2xs leading-snug font-semibold lg:mb-4 caps">
          {eyebrow}
        </p>
        <SplitHeading
          as="h1"
          lead={lead}
          emphasis={emphasis}
          emphasisClass="font-semibold"
          class="max-w-headline text-display lg:text-display-half 4xl:text-display-hero relative font-extralight text-white"
        />
        <p class="max-w-lead text-lead lg:max-w-lead-hero lg:text-lead-hero 4xl:text-lead-hero-xl text-frost mt-6 font-light lg:mt-4.5">
          {description}
        </p>
      </Container>
      <div class="relative overflow-x-clip">
        <Container class="pointer-events-none absolute inset-0">
          <div class="backdrop-blur-bar -right-page-bleed absolute inset-y-0 right-0 left-gutter"></div>
          <div class="bg-space-950/50 -right-page-bleed absolute inset-y-0 right-0 left-gutter"></div>
          <div class="bg-grid/5 absolute inset-x-gutter top-0 h-px"></div>
        </Container>
        {logos && (
          <div class="relative opacity-50 pt-4 pb-6">
            <Container class="relative">
              <p class="text-frost text-2xs leading-snug font-normal caps">
                Trusted by technical teams at:
              </p>
              <LogoMarquee class="mask-fade-x-soft bleed-r mt-1 overflow-clip" />
            </Container>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
<div aria-hidden="true" class="h-svh"></div>

<script>
  import { initHeroScene } from '../../scripts/hero-scene';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  if (canvas)
    initHeroScene(
      canvas,
      document.querySelector<HTMLCanvasElement>('[data-nav-window]'),
    );
</script>
