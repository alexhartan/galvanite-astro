---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import GridMark from '../ui/GridMark.astro';
import BuildArt from '../ui/art/BuildArt.astro';
import ConsistencyArt from '../ui/art/ConsistencyArt.astro';
import PerformanceArt from '../ui/art/PerformanceArt.astro';
import ProcessArt from '../ui/art/ProcessArt.astro';
import StrategyArt from '../ui/art/StrategyArt.astro';
import ToolsArt from '../ui/art/ToolsArt.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
}
const { id = 'why', label, heading } = Astro.props;
const benefits = (await getCollection('benefits')).sort(
  (a, b) => a.data.order - b.data.order,
);
const art = {
  strategy: StrategyArt,
  consistency: ConsistencyArt,
  build: BuildArt,
  performance: PerformanceArt,
  process: ProcessArt,
  tools: ToolsArt,
};
const last = benefits.length - 1;
const right = (index: number) => [
  'block',
  index % 2 === 1 ? 'sm:block' : 'sm:hidden',
  index % 3 === 2 ? 'lg:block' : 'lg:hidden',
];
const edge = (index: number) => [
  index === 0 ? 'block' : 'hidden',
  index === 1 ? 'sm:block' : 'sm:hidden',
  index === 2 ? 'lg:block' : 'lg:hidden',
];
const left = (index: number) => [
  'border-l-0',
  index % 2 === 0 ? 'sm:border-l-0' : 'sm:border-l',
  index % 3 === 0 ? 'lg:border-l-0' : 'lg:border-l',
];
const shift = (index: number) => [
  'ml-0',
  index % 2 === 0 ? 'sm:ml-0' : 'sm:-ml-px',
  index % 3 === 0 ? 'lg:ml-0' : 'lg:-ml-px',
];
const first = (index: number) => [
  index === 0 ? 'border-t-0' : '',
  index < 2 ? 'sm:border-t-0' : 'sm:border-t',
  index < 3 ? 'lg:border-t-0' : 'lg:border-t',
];
const bottom = (index: number) => [
  index === last ? 'block' : 'hidden',
  index >= last - 1 ? 'sm:block' : 'sm:hidden',
  index >= last - 2 ? 'lg:block' : 'lg:hidden',
];
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  data-tone="light"
  class="scroll-mt-nav relative z-10 overflow-clip bg-white pt-40 pb-40 lg:pt-56 lg:pb-56"
>
  <Container class="pointer-events-none absolute inset-0">
    <div class="bg-ink/10 absolute inset-y-0 left-6 w-px"></div>
  </Container>
  <Container class="@container">
    <h2
      id={`${id}-heading`}
      class="text-intent lg:text-intent-lg 4xl:text-intent-xl text-ocean text-center leading-none font-light text-balance"
    >
      {heading}
    </h2>
  </Container>
  <div data-guide class="border-ink/10 relative mt-6 border-t">
    <Container>
      <Eyebrow id={`${id}-label`}>{label}</Eyebrow>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3">
        {benefits.map(({ data }, index) => {
          const Art = art[data.art];
          return (
            <article
              class:list={[
                'group border-ink/10 relative flex flex-col border-t border-l pb-10',
                first(index),
                left(index),
              ]}
            >
              <div
                aria-hidden="true"
                class:list={[
                  'bg-ink/10 bleed-y pointer-events-none absolute right-0 w-px',
                  edge(index),
                ]}
              />
              <div
                aria-hidden="true"
                class:list={[
                  'border-ink/10 pointer-events-none absolute inset-x-0 bottom-0 border-b',
                  bottom(index),
                ]}
              />
              <div
                aria-hidden="true"
                class="from-navy/3 to-navy/0 ease-out-soft pointer-events-none absolute inset-0 bg-linear-to-b opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              />
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 overflow-clip"
              >
                <div class="bg-signal ease-out-soft absolute inset-x-0 bottom-0 h-1 translate-y-full mix-blend-multiply transition-transform duration-500 group-hover:translate-y-0 motion-reduce:transition-none" />
              </div>
              <GridMark
                class:list={['absolute top-0 left-0 z-10 -mt-px', shift(index)]}
              />
              <GridMark
                class:list={[
                  'absolute top-0 left-full z-10 -mt-px -ml-px',
                  right(index),
                ]}
              />
              <GridMark
                class:list={[
                  'absolute top-full left-0 z-10 -mt-px',
                  shift(index),
                  bottom(index),
                ]}
              />
              {index === last && (
                <GridMark class="absolute top-full left-full z-10 -mt-px -ml-px" />
              )}
              <div aria-hidden="true" class="relative h-30 overflow-hidden">
                <div class="absolute bottom-0 left-0 h-45 w-75 origin-bottom-left -translate-x-0.5 translate-y-px scale-60">
                  <Art />
                </div>
              </div>
              <div class="ease-out-soft relative px-10 pt-8 transition-transform duration-300 pointer-fine:group-hover:-translate-y-lift">
                <h3 class="text-azure-deep text-benefit ease-out-soft group-hover:text-ink font-medium whitespace-pre-line transition-colors duration-300">
                  {data.title}
                </h3>
                <p class="text-graphite ease-out-soft mt-2 text-sm text-balance transition-opacity duration-300 pointer-fine:opacity-70 pointer-fine:group-hover:opacity-100">
                  {data.summary}
                </p>
              </div>
            </article>
          );
        })}
      </div>
    </Container>
  </div>
</section>
