---
import { getCollection } from 'astro:content';
import ColumnLines from '../ui/ColumnLines.astro';
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import DepthCard from '../ui/DepthCard.astro';
import ContactArt from '../ui/art/ContactArt.astro';
import BuildArt from '../ui/art/BuildArt.astro';
import PerformanceArt from '../ui/art/PerformanceArt.astro';
import ProcessArt from '../ui/art/ProcessArt.astro';
import StrategyArt from '../ui/art/StrategyArt.astro';
import ToolsArt from '../ui/art/ToolsArt.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
  contact: { heading: string; text: string; alt: string; greeting: string };
}
const { id = 'why', label, heading, contact } = Astro.props;
const benefits = (await getCollection('benefits')).sort(
  (a, b) => a.data.order - b.data.order,
);
const art = {
  strategy: StrategyArt,
  contact: ContactArt,
  build: BuildArt,
  performance: PerformanceArt,
  process: ProcessArt,
  tools: ToolsArt,
};
---

<Section
  id={id}
  labelledby={`${id}-heading`}
  data-scene-end
  clip="all"
  class="pb-28 lg:pb-44"
>
  <div class="relative pt-28 pb-6 lg:pt-44">
    <SectionFrame edge={false} top={false} />
    <Container class="@container">
      <h2
        id={`${id}-heading`}
        class="text-intent lg:text-intent-lg 4xl:text-intent-xl text-ocean text-center leading-none font-light text-balance"
      >
        {heading}
      </h2>
    </Container>
  </div>
  <div data-guide class="border-line relative border-t">
    <Container>
      <Eyebrow id={`${id}-label`}>{label}</Eyebrow>
      <div class="relative grid sm:grid-cols-2 lg:grid-cols-3">
        <ColumnLines
          class="sm:grid-cols-2 lg:grid-cols-3"
          columns={['hidden lg:block', 'hidden sm:block', '']}
          lead
          mark="z-10 -mt-px"
        />
        {benefits.map(({ data }) => {
          const Art = art[data.art];
          return (
            <article class="group relative flex flex-col pb-10">
              <div
                aria-hidden="true"
                class="from-tint to-transparent pointer-events-none absolute inset-0 bg-linear-to-b opacity-0 transition-opacity group-hover:opacity-100 motion-ui"
              />
              <div
                aria-hidden="true"
                class="border-line-solid pointer-events-none absolute -top-px -right-px bottom-0 left-0 border opacity-0 transition-opacity group-hover:opacity-100 motion-ui"
              />
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 overflow-clip"
              >
                <div class="bg-signal absolute inset-x-0 bottom-0 h-1 translate-y-[calc(100%+1px)] mix-blend-multiply transition-transform group-hover:translate-y-0 motion-slow" />
              </div>
              <div aria-hidden="true" class="relative h-30 overflow-hidden">
                <div class="absolute bottom-0 left-0 h-45 w-75 origin-bottom-left -translate-x-0.5 translate-y-px scale-60">
                  <Art />
                </div>
              </div>
              <div class="relative px-10 pt-6 transition-transform pointer-fine:group-hover:-translate-y-lift motion-ui">
                <h3 class="text-azure-deep text-benefit group-hover:text-ink font-semibold whitespace-pre-line transition-colors motion-ui">
                  {data.title}
                </h3>
                <p class="text-graphite mt-2 text-sm text-balance transition-opacity pointer-fine:opacity-70 pointer-fine:group-hover:opacity-100 motion-ui">
                  {data.summary}
                </p>
              </div>
            </article>
          );
        })}
      </div>
    </Container>
  </div>
  <Container class="@container mt-28 lg:mt-44">
    <DepthCard {...contact} />
  </Container>
</Section>
