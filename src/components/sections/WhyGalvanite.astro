---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import ProcessTimeline from '../ui/ProcessTimeline.astro';
import BuildArt from '../ui/art/BuildArt.astro';
import ConsistencyArt from '../ui/art/ConsistencyArt.astro';
import PerformanceArt from '../ui/art/PerformanceArt.astro';
import StrategyArt from '../ui/art/StrategyArt.astro';
import ToolsArt from '../ui/art/ToolsArt.astro';
import GridMark from '../ui/GridMark.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
  description: string;
  process: {
    heading: string;
    description: string;
    weeks: number;
    stages: { name: string; short?: string; start: number; end: number }[];
  };
}
const { id = 'why', label, heading, description, process } = Astro.props;
const benefits = (await getCollection('benefits')).sort(
  (a, b) => a.data.order - b.data.order,
);
const items = [
  ...benefits.slice(0, 4),
  'process' as const,
  ...benefits.slice(4),
];
const art = {
  strategy: StrategyArt,
  consistency: ConsistencyArt,
  build: BuildArt,
  performance: PerformanceArt,
  tools: ToolsArt,
};
const card =
  'ease-out-soft pointer-events-none absolute inset-0 rounded-lg border border-white/15 bg-space-950/50 shadow-card backdrop-blur-bar opacity-0 transition duration-300';
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class="scroll-mt-nav relative z-10 overflow-x-clip pb-40 text-white lg:pb-56"
>
  <SectionFrame inverted />
  <div data-guide class="relative border-t border-white/10">
    <Container>
      <Eyebrow id={`${id}-label`} inverted>
        {label}
      </Eyebrow>
      <div class="mt-28 lg:mt-44">
        <h3 class="text-section">{heading}</h3>
        <p class="text-frost/80 max-w-lead mt-6 text-balance">{description}</p>
      </div>
      <div class="relative mt-16 lg:mt-20">
        <div
          aria-hidden="true"
          class="bg-space-950/50 backdrop-blur-bar absolute inset-0 border-x border-white/10"
        ></div>
        <div
          aria-hidden="true"
          class="bleed-x absolute top-0 h-px bg-white/10"
        ></div>
        <div
          aria-hidden="true"
          class="bleed-x absolute bottom-0 h-px bg-white/10"
        ></div>
        <GridMark inverted class="absolute top-0 left-0" />
        <GridMark inverted class="absolute top-full left-0 -mt-px" />
        <GridMark inverted class="absolute top-0 left-full -ml-px" />
        <GridMark inverted class="absolute top-full left-full -mt-px -ml-px" />
        <div class="relative grid sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => {
            if (item === 'process')
              return (
                <article
                  data-process
                  class="group/process relative flex flex-col pb-14"
                >
                  <div
                    aria-hidden="true"
                    class:list={[
                      card,
                      'pointer-fine:group-hover/process:-translate-y-lift pointer-fine:group-hover/process:opacity-100',
                    ]}
                  />
                  <div class="relative flex h-36 items-end overflow-hidden px-10">
                    <div class="w-full" style="--overhang: 64px">
                      <ProcessTimeline
                        weeks={process.weeks}
                        stages={process.stages}
                      />
                    </div>
                  </div>
                  <div class="ease-out-soft relative px-10 pt-8 transition-transform duration-300 pointer-fine:group-hover/process:-translate-y-lift">
                    <h4 class="text-sky text-benefit ease-out-soft font-medium transition-colors duration-300 group-hover/process:text-white">
                      {process.heading}
                    </h4>
                    <p class="text-frost/80 ease-out-soft mt-2 max-w-md text-sm text-balance transition-opacity duration-300 pointer-fine:opacity-70 pointer-fine:group-hover/process:opacity-100">
                      {process.description}
                    </p>
                  </div>
                </article>
              );
            const { data } = item;
            const Art = art[data.art];
            return (
              <article class="group relative flex flex-col pb-14">
                <div
                  aria-hidden="true"
                  class:list={[
                    card,
                    'pointer-fine:group-hover:-translate-y-lift pointer-fine:group-hover:opacity-100',
                  ]}
                />
                <div aria-hidden="true" class="relative h-36 overflow-hidden">
                  <div class="absolute bottom-0 left-0 h-45 w-75 origin-bottom-left -translate-x-2.5 translate-y-px scale-60">
                    <Art />
                  </div>
                </div>
                <div class="ease-out-soft relative px-10 pt-8 transition-transform duration-300 pointer-fine:group-hover:-translate-y-lift">
                  <h4 class="text-sky text-benefit ease-out-soft font-medium transition-colors duration-300 group-hover:text-white">
                    {data.title}
                  </h4>
                  <p class="text-frost/80 ease-out-soft mt-2 text-sm text-balance transition-opacity duration-300 pointer-fine:opacity-70 pointer-fine:group-hover:opacity-100">
                    {data.summary}
                  </p>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </Container>
  </div>
</section>
