---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import GridMark from '../ui/GridMark.astro';
import BuildArt from '../ui/art/BuildArt.astro';
import ConsistencyArt from '../ui/art/ConsistencyArt.astro';
import PerformanceArt from '../ui/art/PerformanceArt.astro';
import ProcessArt from '../ui/art/ProcessArt.astro';
import StrategyArt from '../ui/art/StrategyArt.astro';
import ToolsArt from '../ui/art/ToolsArt.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
}
const { id = 'why', label, heading } = Astro.props;
const benefits = (await getCollection('benefits')).sort(
  (a, b) => a.data.order - b.data.order,
);
const art = {
  strategy: StrategyArt,
  consistency: ConsistencyArt,
  build: BuildArt,
  performance: PerformanceArt,
  process: ProcessArt,
  tools: ToolsArt,
};
const last = benefits.length - 1;
const right = (index: number) => [
  'block',
  index % 2 === 1 ? 'sm:block' : 'sm:hidden',
  index % 3 === 2 ? 'lg:block' : 'lg:hidden',
];
const bottom = (index: number) => [
  index === last ? 'block' : 'hidden',
  index >= last - 1 ? 'sm:block' : 'sm:hidden',
  index >= last - 2 ? 'lg:block' : 'lg:hidden',
];
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  data-tone="light"
  class="scroll-mt-nav relative z-10 overflow-x-clip bg-white pt-40 pb-40 lg:pt-56 lg:pb-56"
>
  <Container class="pointer-events-none absolute inset-0">
    <div class="bg-ink/10 absolute inset-y-0 left-6 w-px"></div>
  </Container>
  <Container class="@container">
    <h2
      id={`${id}-heading`}
      class="text-statement lg:text-mission 4xl:text-mission-xl text-ocean text-center leading-none font-extralight text-balance"
    >
      {heading}
    </h2>
  </Container>
  <div data-guide class="relative mt-9 lg:mt-12">
    <Container>
      <Eyebrow id={`${id}-label`}>{label}</Eyebrow>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3">
        {benefits.map(({ data }, index) => {
          const Art = art[data.art];
          return (
            <article class="group border-ink/10 hover:bg-navy/3 ease-out-soft relative flex flex-col border-t border-l pb-14 transition-colors duration-300">
              <div
                aria-hidden="true"
                class:list={[
                  'border-ink/10 pointer-events-none absolute inset-y-0 right-0 border-r',
                  right(index),
                ]}
              />
              <div
                aria-hidden="true"
                class:list={[
                  'border-ink/10 pointer-events-none absolute inset-x-0 bottom-0 border-b',
                  bottom(index),
                ]}
              />
              <GridMark class="absolute top-0 left-0 z-10" />
              <GridMark
                class:list={['absolute top-0 left-full z-10', right(index)]}
              />
              <GridMark
                class:list={['absolute top-full left-0 z-10', bottom(index)]}
              />
              {index === last && (
                <GridMark class="absolute top-full left-full z-10" />
              )}
              <div aria-hidden="true" class="relative h-30 overflow-hidden">
                <div class="absolute bottom-0 left-0 h-45 w-75 origin-bottom-left -translate-x-0.5 translate-y-px scale-60">
                  <Art />
                </div>
              </div>
              <div class="ease-out-soft relative px-10 pt-8 transition-transform duration-300 pointer-fine:group-hover:-translate-y-lift">
                <h3 class="text-azure-deep text-benefit ease-out-soft group-hover:text-ink font-light transition-colors duration-300">
                  {data.title}
                </h3>
                <p class="text-graphite ease-out-soft mt-2 text-sm text-balance transition-opacity duration-300 pointer-fine:opacity-70 pointer-fine:group-hover:opacity-100">
                  {data.summary}
                </p>
              </div>
            </article>
          );
        })}
      </div>
    </Container>
  </div>
</section>
