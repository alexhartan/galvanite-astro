---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import GridMark from '../ui/GridMark.astro';
import ProcessTimeline from '../ui/ProcessTimeline.astro';
import BuildArt from '../ui/art/BuildArt.astro';
import ConsistencyArt from '../ui/art/ConsistencyArt.astro';
import PerformanceArt from '../ui/art/PerformanceArt.astro';
import StrategyArt from '../ui/art/StrategyArt.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
  description: string;
  process: {
    heading: string;
    description: string;
    weeks: number;
    stages: { name: string; short?: string; start: number; end: number }[];
  };
}
const { id = 'why', label, heading, description, process } = Astro.props;
const benefits = (await getCollection('benefits')).sort(
  (a, b) => a.data.order - b.data.order,
);
const art = {
  strategy: StrategyArt,
  consistency: ConsistencyArt,
  build: BuildArt,
  performance: PerformanceArt,
};
const card =
  'ease-out-soft pointer-events-none absolute inset-0 rounded-sm bg-space-950/50 backdrop-blur-bar opacity-0 transition duration-300';
const line = 'bleed-x absolute top-0 h-px bg-white/10';
const right = '3xl:block lg:hidden';
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class="scroll-mt-nav relative z-10 overflow-x-clip pb-40 text-white lg:pb-56"
>
  <SectionFrame inverted />
  <div data-guide class="relative border-t border-white/10">
    <Container>
      <Eyebrow id={`${id}-label`} inverted>
        {label}
      </Eyebrow>
      <div class="mt-28 lg:mt-44">
        <h3 class="text-section">{heading}</h3>
        <p class="text-frost/80 max-w-lead mt-6 text-balance">{description}</p>
      </div>
      <div class="relative mt-16 grid sm:grid-cols-2 lg:mt-20 xl:grid-cols-4">
        <div aria-hidden="true" class={line}></div>
        {[
          'left-0',
          'left-1/2 max-sm:hidden',
          'left-1/4 max-xl:hidden',
          'left-3/4 max-xl:hidden',
        ].map((position) => (
          <GridMark inverted class:list={['absolute top-0', position]} />
        ))}
        <GridMark
          inverted
          class:list={[right, 'absolute top-0 left-full -ml-px']}
        />
        {benefits.map(({ data }) => {
          const Art = art[data.art];
          return (
            <article class="group relative flex flex-col py-10">
              <div
                aria-hidden="true"
                class:list={[
                  card,
                  'pointer-fine:group-hover:-translate-y-1 pointer-fine:group-hover:opacity-100',
                ]}
              />
              <div aria-hidden="true" class="relative h-32 overflow-hidden">
                <div class="absolute top-0 left-0 h-52.5 w-full origin-top-left scale-60">
                  <Art />
                </div>
              </div>
              <div class="ease-out-soft relative px-6 pt-5 transition-transform duration-300 pointer-fine:group-hover:-translate-y-1">
                <h4 class="text-sky text-benefit ease-out-soft font-normal transition-colors duration-300 group-hover:text-white">
                  {data.title}
                </h4>
                <p class="text-frost/80 ease-out-soft mt-2 text-sm text-balance transition-opacity duration-300 pointer-fine:opacity-70 pointer-fine:group-hover:opacity-100">
                  {data.summary}
                </p>
              </div>
            </article>
          );
        })}
      </div>
      <div class="relative grid xl:grid-cols-4">
        <div aria-hidden="true" class={line}></div>
        {['left-0', 'left-1/4 max-xl:hidden', 'left-3/4 max-xl:hidden'].map(
          (position) => (
            <GridMark inverted class:list={['absolute top-0', position]} />
          ),
        )}
        <GridMark
          inverted
          class:list={[right, 'absolute top-0 left-full -ml-px']}
        />
        <div
          data-process
          class="group/process relative px-6 py-10 xl:col-span-2 xl:col-start-2"
        >
          <div
            aria-hidden="true"
            class:list={[
              card,
              'pointer-fine:group-hover/process:-translate-y-1 pointer-fine:group-hover/process:opacity-100',
            ]}
          />
          <div class="relative">
            <h4 class="text-sky text-process ease-out-soft font-light text-balance transition-colors duration-300 group-hover/process:text-white">
              {process.heading}
            </h4>
            <p class="text-frost/80 ease-out-soft mt-3 max-w-md text-sm text-balance transition-opacity duration-300 pointer-fine:opacity-70 pointer-fine:group-hover/process:opacity-100">
              {process.description}
            </p>
            <div class="mt-6">
              <ProcessTimeline weeks={process.weeks} stages={process.stages} />
            </div>
          </div>
        </div>
      </div>
    </Container>
  </div>
</section>
