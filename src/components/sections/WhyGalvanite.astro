---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import GridMark from '../ui/GridMark.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
  stats: { value: string; label: string }[];
}
const { id = 'why', label, heading, stats } = Astro.props;
const benefits = (await getCollection('benefits')).sort(
  (a, b) => a.data.order - b.data.order,
);
const right = '3xl:block lg:hidden';
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class="pt-nav-line relative z-10 overflow-x-clip pb-40 text-white lg:pb-56"
>
  <Container class="absolute inset-0">
    <div class="absolute inset-y-0 left-6 w-px bg-white/10"></div>
    <div
      class:list={[right, 'absolute inset-y-0 right-6 w-px bg-white/10']}
    ></div>
  </Container>
  <div data-guide class="relative border-t border-white/10">
    <Container class="absolute inset-x-0 top-0">
      <GridMark inverted class="absolute top-0 left-6 -mt-px" />
      <div class:list={[right, 'absolute top-0 right-6 w-0']}>
        <GridMark inverted class="-mt-px" />
      </div>
    </Container>
    <Container>
      <Eyebrow id={`${id}-label`} inverted>
        {label}
      </Eyebrow>
      <h3 class="text-kpi-lg mt-28 text-center font-extralight lg:mt-40">
        {heading}
      </h3>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {benefits.map(({ data }) => (
          <article class="relative flex flex-col">
            <div
              aria-hidden="true"
              class="bg-abyss/30 h-40 border border-b-0 border-white/5"
            />
            <div class="@container flex-1 bg-white p-5">
              <h4 class="text-ink text-benefit font-medium tracking-tight">
                {data.title}
              </h4>
              <p class="text-ink/70 mt-1.5 text-sm text-balance">
                {data.summary}
              </p>
            </div>
          </article>
        ))}
      </div>
      <dl class="bg-abyss/50 relative mt-24 grid gap-10 px-8 py-14 sm:grid-cols-3 lg:mt-40">
        <div class="bleed-x absolute top-0 h-px bg-white/10"></div>
        <div class="bleed-x absolute bottom-0 h-px bg-white/10"></div>
        <GridMark inverted class="absolute top-0 left-0" />
        <GridMark inverted class="absolute top-full left-0 -mt-px" />
        <GridMark
          inverted
          class:list={[right, 'absolute top-0 left-full -ml-px']}
        />
        <GridMark
          inverted
          class:list={[right, 'absolute top-full left-full -mt-px -ml-px']}
        />
        {stats.map(({ value, label }) => (
          <div class="flex flex-col-reverse gap-2 sm:justify-self-center">
            <dt class="text-sky max-w-44 text-sm leading-tight">{label}</dt>
            <dd class="text-kpi-lg font-light">{value}</dd>
          </div>
        ))}
      </dl>
    </Container>
  </div>
</section>
