---
import { getCollection } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import GridMark from '../ui/GridMark.astro';
import ProcessTimeline from '../ui/ProcessTimeline.astro';
import BuildArt from '../ui/art/BuildArt.astro';
import ConsistencyArt from '../ui/art/ConsistencyArt.astro';
import PerformanceArt from '../ui/art/PerformanceArt.astro';
import StrategyArt from '../ui/art/StrategyArt.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
  process: {
    heading: string;
    description: string;
    weeks: number;
    stages: { name: string; short?: string; start: number; end: number }[];
  };
}
const { id = 'why', label, heading, process } = Astro.props;
const benefits = (await getCollection('benefits')).sort(
  (a, b) => a.data.order - b.data.order,
);
const art = {
  strategy: StrategyArt,
  consistency: ConsistencyArt,
  build: BuildArt,
  performance: PerformanceArt,
};
const right = '3xl:block lg:hidden';
const edges = [
  'max-sm:border-r',
  'max-lg:border-r max-sm:border-l',
  'max-sm:border-r sm:max-xl:border-l max-sm:border-l',
  'max-lg:border-r 3xl:border-r max-sm:border-l',
];
const line = 'bleed-x absolute z-10 h-px bg-white/10';
const panel =
  'backdrop-blur-bar bg-space-950/50 absolute inset-y-0 left-0 right-0 border-x border-white/10 lg:-right-6 lg:border-r-0 3xl:right-0 3xl:border-r';
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class="scroll-mt-nav relative z-10 overflow-x-clip pb-40 text-white lg:pb-56"
>
  <SectionFrame inverted />
  <div data-guide class="relative border-t border-white/10">
    <Container>
      <Eyebrow id={`${id}-label`} inverted>
        {label}
      </Eyebrow>
      <h3 class="text-section mt-28 pb-6.75 lg:mt-44">{heading}</h3>
      <div class="group/process relative flex flex-col gap-9 py-5 lg:flex-row lg:gap-18">
        <div aria-hidden="true" class={panel}></div>
        <div class:list={[line, 'top-0']}></div>
        <GridMark inverted class="absolute top-0 left-0 z-10" />
        <GridMark
          inverted
          class:list={[right, 'absolute top-0 left-full z-10 -ml-px']}
        />
        <div class="relative flex flex-col justify-center gap-3 pl-6 lg:w-1/3 lg:shrink-0">
          <h4 class="text-sky text-process ease-out-soft font-light text-balance transition-colors duration-300 group-hover/process:text-white">
            {process.heading}
          </h4>
          <p class="text-frost/80 ease-out-soft max-w-sm text-sm text-balance transition-opacity duration-300 pointer-fine:opacity-70 pointer-fine:group-hover/process:opacity-100">
            {process.description}
          </p>
        </div>
        <div class="relative lg:min-w-0 lg:flex-1 lg:pr-3">
          <ProcessTimeline weeks={process.weeks} stages={process.stages} />
        </div>
      </div>
      <div class="relative grid gap-y-12 sm:grid-cols-2 sm:gap-x-6 xl:grid-cols-4 xl:gap-x-0">
        <div class:list={[line, 'top-0']}></div>
        <div class:list={[line, 'top-52.5 max-xl:hidden']}></div>
        <GridMark inverted class="absolute top-0 left-0 z-10" />
        <GridMark
          inverted
          class:list={[right, 'absolute top-0 left-full z-10 -ml-px']}
        />
        {['left-0', 'left-1/4', 'left-1/2', 'left-3/4', 'left-full -ml-px'].map(
          (position, index) => (
            <GridMark
              inverted
              class:list={[
                'absolute top-52.5 z-10 max-xl:hidden',
                position,
                index === 4 && right,
              ]}
            />
          ),
        )}
        {benefits.map(({ data }, index) => {
          const Art = art[data.art];
          return (
            <article class="group relative flex flex-col">
              <div
                aria-hidden="true"
                class:list={[
                  'backdrop-blur-bar bg-space-950/50 relative h-52.5 overflow-hidden border-white/10',
                  index === 0 && 'border-l',
                  edges[index],
                ]}
              >
                <div class="from-deep-800 to-deep-950 ease-out-soft absolute inset-0 bg-linear-to-t opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
                <Art />
              </div>
              <div class="@container pt-4 pl-6">
                <h4 class="text-sky text-benefit ease-out-soft font-normal transition-colors duration-300 group-hover:text-white">
                  {data.title}
                </h4>
                <p class="text-frost/80 ease-out-soft mt-2 max-w-72 text-sm text-balance transition-opacity duration-300 pointer-fine:opacity-70 pointer-fine:group-hover:opacity-100">
                  {data.summary}
                </p>
              </div>
            </article>
          );
        })}
      </div>
    </Container>
  </div>
</section>
