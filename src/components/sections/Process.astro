---
import { Image } from 'astro:assets';
import alex from '../../assets/process/alex.jpg';
import CheckIcon from '../ui/CheckIcon.astro';
import Container from '../ui/Container.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
  description: string;
  weeks: number;
  stages: { name: string; start: number; end: number }[];
}
const {
  id = 'process',
  label,
  heading,
  description,
  weeks,
  stages,
} = Astro.props;
const confetti = Array.from({ length: 8 }, (_, index) => {
  const angle = (index / 8) * Math.PI * 2;
  const reach = index % 2 ? 22 : 17;
  return {
    style: `--dx: ${(Math.cos(angle) * reach).toFixed(1)}px; --dy: ${(Math.sin(angle) * reach * 0.75).toFixed(1)}px`,
    tone: ['bg-signal', 'bg-azure', 'bg-sky', 'bg-ocean'][index % 4],
  };
});
const label_ =
  'text-label absolute inset-0 flex items-center justify-center font-semibold tracking-wider uppercase';
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class="scroll-mt-nav relative z-10 overflow-hidden text-white"
>
  <SectionFrame inverted bottom />
  <div data-guide class="relative border-t border-white/10">
    <Container class="py-40 lg:pt-48 lg:pb-60">
      <Eyebrow id={`${id}-label`} inverted>
        {label}
      </Eyebrow>
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:gap-0">
        <h3 class="text-4xl leading-none font-light text-balance lg:w-1/2 lg:pr-8">
          {heading}
        </h3>
        <p class="text-azure font-light text-balance lg:w-1/2">{description}</p>
      </div>
      <div class="-mx-6 mt-9 overflow-x-auto px-6 pt-14 lg:mx-0 lg:overflow-visible lg:px-0 lg:pt-0">
        <div
          data-timeline
          class="bg-abyss/50 @container relative mx-px min-w-3xl border-y border-white/10 py-14"
          style={`--weeks: ${weeks}`}
        >
          <div aria-hidden="true" class="absolute inset-0 flex">
            {Array.from({ length: weeks }, (_, index) => (
              <div
                class:list={['flex-1', index > 0 && 'border-l border-white/5']}
              />
            ))}
          </div>
          <ol class="relative space-y-2.5">
            {stages.map(({ name, start, end }) => (
              <li
                data-stage
                data-end={end / weeks}
                class="group/stage stage-span relative h-10"
                style={`--start: ${start}; --end: ${end}`}
              >
                <div class="bg-ink/40 absolute inset-0 rounded-sm border border-white/10">
                  <span class:list={[label_, 'text-azure']}>{name}</span>
                </div>
                <div
                  aria-hidden="true"
                  class="stage-reveal absolute inset-0 overflow-hidden rounded-sm bg-white/90"
                >
                  <div class="timeline-trail from-frost via-chalk to-night/0 absolute inset-y-0 bg-linear-to-l via-15% mix-blend-multiply" />
                  <span class="absolute top-1/2 left-5">
                    {confetti.map(({ style, tone }) => (
                      <span
                        style={style}
                        class:list={[
                          'absolute -top-0.5 -left-0.5 size-1 rounded-full opacity-0 motion-safe:group-data-complete/stage:animate-confetti',
                          tone,
                        ]}
                      />
                    ))}
                  </span>
                  <CheckIcon class="ease-out-soft absolute top-1/2 left-2.5 -translate-y-1/2 scale-75 opacity-0 transition-[opacity,scale] duration-300 group-data-complete/stage:scale-100 group-data-complete/stage:opacity-100" />
                  <span class:list={[label_, 'text-ink']}>{name}</span>
                </div>
              </li>
            ))}
          </ol>
          <div
            aria-hidden="true"
            class="timeline-line absolute inset-y-0 w-px bg-linear-to-b from-white/10 via-white to-white/10"
          ></div>
          <div
            data-tooltip
            aria-hidden="true"
            class="timeline-tip ease-out-soft text-sky text-xs pointer-events-none absolute bottom-2 ml-2 flex translate-y-1 items-center gap-2 leading-tight opacity-0 transition-[opacity,translate] duration-300 data-visible:translate-y-0 data-visible:opacity-100"
          >
            <Image
              src={alex}
              alt=""
              width={24}
              height={24}
              densities={[1, 2]}
              format="webp"
              class="size-6 rounded-sm object-cover"
            />
            <span class="w-min">Weekly Sync</span>
          </div>
        </div>
      </div>
    </Container>
  </div>
</section>

<script>
  import { initTimeline } from '../../scripts/timeline';

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-timeline]',
  )) {
    initTimeline(root);
  }
</script>
