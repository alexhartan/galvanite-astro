---
import Container from '../ui/Container.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  id?: string;
  label: string;
  statement: { text: string; strong?: boolean }[];
}
const { id = 'intro', label, statement } = Astro.props;
const fullText = statement.map(({ text }) => text).join('');
let letterIndex = 0;
const segments = statement.map(({ text, strong }) => ({
  strong,
  words: text.split(/(\s+)/).map((part) =>
    /^\s+$/.test(part)
      ? { space: part, letters: [] }
      : {
          space: '',
          letters: [...part].map((char) => ({ char, index: letterIndex++ })),
        },
  ),
}));
const reveal = letterIndex + 12;
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class="scroll-mt-nav relative z-10 overflow-hidden bg-white"
>
  <SectionFrame />
  <div data-guide class="border-ink/10 relative border-t">
    <Container class="@container py-32 lg:py-56">
      <Eyebrow id={`${id}-label`}>{label}</Eyebrow>
      <p
        data-reveal
        class="max-w-mission text-statement lg:text-mission text-ink leading-none font-extralight"
        style={`--n: ${reveal}`}
      >
        <span class="sr-only">{fullText}</span>
        {segments.map(({ strong, words }) => {
          const Tag = strong ? 'strong' : 'span';
          return (
            <Tag class:list={[strong && 'font-medium']} aria-hidden="true">
              {words.map(({ space, letters }) =>
                space ? (
                  space
                ) : (
                  <span class="inline-block whitespace-nowrap">
                    {letters.map(({ char, index }) => (
                      <span class="reveal-letter" style={`--i: ${index}`}>
                        {char}
                      </span>
                    ))}
                  </span>
                ),
              )}
            </Tag>
          );
        })}
      </p>
    </Container>
  </div>
</section>

<script>
  import { initReveal } from '../../scripts/reveal';

  for (const element of document.querySelectorAll<HTMLElement>(
    '[data-reveal]',
  )) {
    initReveal(element);
  }
</script>
