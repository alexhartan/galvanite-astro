---
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import GridMark from '../ui/GridMark.astro';

interface Props {
  id?: string;
  label: string;
  statement: { text: string; strong?: boolean }[];
}
const { id = 'intro', label, statement } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class="pt-nav-line relative z-10 flex h-svh flex-col overflow-hidden bg-white"
>
  <Container class="absolute inset-0">
    <div class="bg-ink/10 absolute inset-y-0 left-6 w-px"></div>
  </Container>
  <div data-guide class="border-ink/10 relative flex flex-1 flex-col border-t">
    <Container class="absolute inset-x-0 top-0">
      <GridMark class="absolute top-0 left-6 -mt-px" />
      <div class="3xl:block absolute top-0 right-6 w-0 lg:hidden">
        <div class="bg-ink/10 absolute top-0 h-svh w-px"></div>
        <GridMark class="-mt-px" />
      </div>
    </Container>
    <Container class="@container flex flex-1 flex-col justify-center pb-nav">
      <Eyebrow id={`${id}-label`}>{label}</Eyebrow>
      <p class="max-w-mission text-statement lg:text-mission text-ocean font-extralight">
        {statement.map(({ text, strong }) =>
          strong ? <strong class="font-medium">{text}</strong> : text,
        )}
      </p>
    </Container>
  </div>
</section>
