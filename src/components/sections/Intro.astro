---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  id?: string;
  label: string;
  statement: { text: string; strong?: boolean }[];
}
const { id = 'intro', label, statement } = Astro.props;
const fullText = statement.map(({ text }) => text).join('');
let letterIndex = 0;
type Run = { strong?: boolean; letters: { char: string; index: number }[] };
const words: ({ space: string } | { runs: Run[] })[] = [];
let word: { runs: Run[] } | null = null;
for (const { text, strong } of statement) {
  for (const part of text.split(/(\s+)/).filter(Boolean)) {
    if (/^\s+$/.test(part)) {
      words.push({ space: part });
      word = null;
      continue;
    }
    const run = {
      strong,
      letters: [...part].map((char) => ({ char, index: letterIndex++ })),
    };
    if (word) word.runs.push(run);
    else {
      word = { runs: [run] };
      words.push(word);
    }
  }
}
const reveal = letterIndex + 10;
---

<Section id={id}>
  <SectionFrame edge={false} />
  <div data-guide class="border-line relative overflow-clip border-t">
    <Container class="@container 4xl:pb-60 py-48 lg:py-80">
      <Eyebrow id={`${id}-label`}>{label}</Eyebrow>
      <div data-parallax="0.25" class="translate-y-(--shift)">
        <p
          data-reveal
          class="max-w-mission text-statement lg:text-statement-lg 4xl:text-statement-xl text-ink leading-none font-extralight text-balance"
          style={`--n: ${reveal}`}
        >
          <span class="sr-only">{fullText}</span>
          {words.map((item) =>
            'space' in item ? (
              item.space
            ) : (
              <span class="inline-block whitespace-nowrap" aria-hidden="true">
                {item.runs.map(({ strong, letters }) => {
                  const Tag = strong ? 'strong' : 'span';
                  return (
                    <Tag class:list={[strong && 'font-medium']}>
                      {letters.map(({ char, index }) => (
                        <span class="reveal-letter" style={`--i: ${index}`}>
                          {char}
                        </span>
                      ))}
                    </Tag>
                  );
                })}
              </span>
            ),
          )}
        </p>
      </div>
    </Container>
  </div>
</Section>

<script>
  import '../../scripts/parallax';
  import { initReveal } from '../../scripts/letter-reveal';

  for (const element of document.querySelectorAll<HTMLElement>(
    '[data-reveal]',
  )) {
    initReveal(element);
  }
</script>
