---
import Container from '../ui/Container.astro';
import GridMark from '../ui/GridMark.astro';

interface Props {
  id?: string;
  label: string;
  statement: string;
  emphasis: string;
}
const { id = 'intro', label, statement, emphasis } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class="relative z-10 flex h-svh flex-col justify-center overflow-hidden bg-white"
>
  <Container class="absolute inset-0">
    <div class="bg-ink/10 absolute inset-y-0 left-6 w-px"></div>
  </Container>
  <div class="border-ink/10 relative border-t">
    <Container class="relative">
      <GridMark class="absolute top-0 left-6" />
      <div class="3xl:block absolute top-0 right-6 w-0 lg:hidden">
        <div class="bg-ink/10 absolute top-0 h-svh w-px"></div>
        <GridMark />
      </div>
      <p class="max-w-statement text-statement text-ink font-light">
        {statement} <strong class="font-semibold">{emphasis}</strong>.
      </p>
    </Container>
    <div class="text-statement pt-cap-statement absolute top-0 left-5">
      <h2
        id={`${id}-label`}
        class="text-ink/60 -mt-cap-label text-xs font-medium tracking-widest uppercase"
      >
        {label}
      </h2>
    </div>
  </div>
</section>
