---
import Container from '../ui/Container.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  id?: string;
  label: string;
  statement: { text: string; strong?: boolean }[];
  fill?: boolean;
}
const { id = 'intro', label, statement, fill = false } = Astro.props;
const fullText = statement.map(({ text }) => text).join('');
let letterIndex = 0;
const segments = statement.map(({ text, strong }) => ({
  strong,
  words: text.split(/(\s+)/).map((part) =>
    /^\s+$/.test(part)
      ? { space: part, letters: [] }
      : {
          space: '',
          letters: [...part].map((char) => ({ char, index: letterIndex++ })),
        },
  ),
}));
const reveal = letterIndex + 6;
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  data-tone="light"
  class="scroll-mt-nav relative z-10 overflow-x-clip bg-white"
>
  <SectionFrame edge={false} />
  <div data-guide class="border-ink/10 relative overflow-clip border-t">
    <Container
      class:list={[
        '@container',
        fill
          ? 'flex min-h-svh flex-col justify-center py-24'
          : 'py-48 lg:py-80',
      ]}
    >
      <Eyebrow id={`${id}-label`}>{label}</Eyebrow>
      <div data-parallax class="translate-y-(--shift)">
        <p
          data-reveal
          class="max-w-mission text-statement lg:text-mission 4xl:text-mission-xl text-ink leading-none font-extralight text-balance"
          style={`--n: ${reveal}`}
        >
          <span class="sr-only">{fullText}</span>
          {segments.map(({ strong, words }) => {
            const Tag = strong ? 'strong' : 'span';
            return (
              <Tag class:list={[strong && 'font-medium']} aria-hidden="true">
                {words.map(({ space, letters }) =>
                  space ? (
                    space
                  ) : (
                    <span class="inline-block whitespace-nowrap">
                      {letters.map(({ char, index }) => (
                        <span class="reveal-letter" style={`--i: ${index}`}>
                          {char}
                        </span>
                      ))}
                    </span>
                  ),
                )}
              </Tag>
            );
          })}
        </p>
      </div>
    </Container>
  </div>
</section>

<script>
  import { initParallax } from '../../scripts/parallax';
  import { initReveal } from '../../scripts/reveal';

  for (const element of document.querySelectorAll<HTMLElement>(
    '[data-reveal]',
  )) {
    initReveal(element);
  }
  for (const element of document.querySelectorAll<HTMLElement>(
    '#intro [data-parallax]',
  )) {
    initParallax(element, 0.25);
  }
</script>
