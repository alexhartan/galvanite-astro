---
import { getCollection } from 'astro:content';
import camera from '../../scripts/pricing-camera.json';
import Container from '../ui/Container.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
  ctaHref?: string;
}
const {
  id = 'engagements',
  label,
  heading,
  ctaHref = '#contact',
} = Astro.props;
const engagements = (await getCollection('engagements')).sort(
  (a, b) => a.data.order - b.data.order,
);
const tiers = {
  standard: {
    box: 'ease-out-soft transition-opacity duration-300 lg:opacity-90 lg:hover:opacity-100 lg:focus-within:opacity-100',
    name: 'text-white',
    muted: 'text-white/80',
    price: 'text-kpi text-frost mt-price',
    plus: 1.25,
    rule: 'border-white/10',
    item: 'text-frost',
    cta: 'bg-ink/60 text-white hover:bg-ink lg:opacity-0 lg:group-hover:opacity-100 lg:group-focus-within:opacity-100',
  },
  featured: {
    box: 'bg-white',
    name: 'text-ink',
    muted: 'text-ink',
    price: 'text-kpi-lg text-ink mt-price-featured',
    plus: 2.5,
    rule: 'border-ink/10',
    item: 'text-ocean',
    cta: 'bg-signal text-ink hover:bg-signal-strong',
  },
  premium: {
    box: 'bg-abyss/50 ring-1 ring-white/10 ring-inset ease-out-soft transition-opacity duration-300 lg:opacity-90 lg:hover:opacity-100 lg:focus-within:opacity-100',
    name: 'text-white',
    muted: 'text-white/80',
    price: 'text-kpi text-frost mt-price',
    plus: 2.5,
    rule: 'border-white/10',
    item: 'text-frost',
    cta: 'bg-ink/60 text-white hover:bg-ink lg:opacity-0 lg:group-hover:opacity-100 lg:group-focus-within:opacity-100',
  },
};
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  data-scene-path={JSON.stringify(camera)}
  class="scroll-mt-nav relative z-10 overflow-hidden pb-32 text-white"
>
  <SectionFrame inverted />
  <div data-guide class="relative border-t border-white/10">
    <Container>
      <Eyebrow id={`${id}-label`} inverted>
        {label}
      </Eyebrow>
      <h3 class="text-statement mt-24 text-center font-light lg:mt-36">
        {heading}
      </h3>
      <div class="mt-14 grid gap-6 lg:grid-cols-3 lg:gap-0">
        {engagements.map(({ data }) => {
          const tier = tiers[data.tier];
          return (
            <article
              class:list={[
                'group relative flex flex-col px-8 pt-11 pb-6',
                tier.box,
              ]}
            >
              {data.tier === 'featured' && (
                <p class="to-ocean-50 text-azure absolute inset-x-0 top-0 bg-linear-to-r from-white text-label px-4 py-2 text-right font-semibold tracking-widest uppercase">
                  Most popular
                </p>
              )}
              <h4 class:list={['text-2xl font-semibold', tier.name]}>
                {data.name}
              </h4>
              <p class:list={['mt-1.5 text-sm text-balance', tier.muted]}>
                {data.audience}
              </p>
              <p
                class:list={[
                  'border-b pb-6 font-semibold tracking-price',
                  tier.price,
                  tier.rule,
                ]}
              >
                {data.pricePrefix && (
                  <span class="font-light">{data.pricePrefix} </span>
                )}
                {data.price}
                <span class="text-azure text-label mt-3 block tracking-widest uppercase">
                  {data.duration}
                </span>
              </p>
              <ul class="mt-6 mb-6 space-y-1.5" role="list">
                {data.features.map((feature) => (
                  <li class:list={['flex gap-3 text-sm', tier.item]}>
                    <span
                      aria-hidden="true"
                      class="flex h-lh shrink-0 items-center"
                    >
                      <svg
                        class="text-signal size-2.5"
                        viewBox="0 0 10 10"
                        fill="none"
                        stroke="currentColor"
                        stroke-width={tier.plus}
                      >
                        <path d="M5 0v10M0 5h10" />
                      </svg>
                    </span>
                    {feature}
                  </li>
                ))}
              </ul>
              <a
                href={ctaHref}
                class:list={[
                  'ease-out-soft mt-auto flex h-12 items-center justify-center rounded-sm font-semibold transition-[opacity,background-color] duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current',
                  tier.cta,
                ]}
              >
                Book a Call with Alex
              </a>
            </article>
          );
        })}
      </div>
    </Container>
  </div>
</section>
