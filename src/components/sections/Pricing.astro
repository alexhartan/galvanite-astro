---
import CtaButton from '../ui/CtaButton.astro';
import { getCollection } from 'astro:content';
import camera from '../../scripts/pricing-camera.json';
import Container from '../ui/Container.astro';
import SplitHeading from '../ui/SplitHeading.astro';
import Section from '../ui/Section.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import SparkIcon from '../ui/SparkIcon.astro';
import Eyebrow from '../ui/Eyebrow.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
  emphasis?: string;
  ctaHref?: string;
}
const {
  id = 'engagements',
  label,
  heading,
  emphasis,
  ctaHref = '#contact',
} = Astro.props;
const engagements = (await getCollection('engagements')).sort(
  (a, b) => a.data.order - b.data.order,
);
const standard = {
  box: 'transition-opacity lg:opacity-90 lg:hover:opacity-100 lg:focus-within:opacity-100 motion-ui',
  name: 'text-white',
  muted: 'text-white/80',
  price: 'text-price text-frost mt-price font-medium',
  mark: 'text-sky',
  rule: 'max-lg:border-b border-line-dark',
  item: 'text-frost',
};
const tiers = {
  standard,
  premium: { ...standard, mark: 'text-signal' },
  featured: {
    box: 'bg-white z-10 ease-in-out-soft origin-(--origin) transition-transform duration-300 hover:scale-103',
    name: 'text-ocean',
    muted: 'text-ink',
    price: 'text-price-lg text-ink mt-price-featured font-semibold',
    mark: 'text-signal',
    rule: 'border-b border-line -mx-8 px-8',
    item: 'text-ocean font-medium',
  },
};
---

<Section id={id} tone="dark" data-scene-path={JSON.stringify(camera)}>
  <SectionFrame inverted />
  <div data-guide class="relative border-t border-line-dark">
    <Container class="pb-14 lg:pb-16">
      <Eyebrow id={`${id}-label`} inverted>
        {label}
      </Eyebrow>
      <div class="pt-28 lg:pt-40">
        <SplitHeading
          as="h3"
          lead={heading}
          emphasis={emphasis}
          emphasisClass="font-normal"
          class="text-section text-center"
        />
        <div class="lg:grid-rows-offer mt-14 grid gap-6 lg:grid-cols-3 lg:gap-0">
          {engagements.map(({ data }, index) => {
            const tier = tiers[data.tier];
            const first = index === 0;
            const guide = first && (
              <div class="w-triple absolute bottom-0 left-0 h-px bg-line-dark max-lg:hidden" />
            );
            return (
              <article
                style={
                  data.tier === 'featured' ? '--origin: 50% 46%' : undefined
                }
                class:list={[
                  'group relative flex flex-col text-balance lg:row-span-3 lg:grid lg:grid-rows-subgrid',
                  tier.box,
                ]}
              >
                <div class="relative px-8 pt-11">
                  {data.tier === 'featured' && (
                    <p class="to-ocean-50 text-sky absolute inset-x-0 top-0 bg-linear-to-r from-white text-xs px-4 py-2 text-right font-semibold caps">
                      Most popular
                    </p>
                  )}
                  <h4
                    class:list={[
                      'text-2xl font-semibold tracking-tight',
                      tier.name,
                    ]}
                  >
                    {data.name}
                  </h4>
                  <p class:list={['mt-1.5 text-base text-balance', tier.muted]}>
                    {data.audience}
                  </p>
                  <p
                    class:list={['pb-6 tracking-title', tier.price, tier.rule]}
                  >
                    {data.pricePrefix && (
                      <span class="font-light">{data.pricePrefix} </span>
                    )}
                    {data.price}
                    <span class:list={['text-sky mt-3 block text-sm caps']}>
                      {data.duration}
                    </span>
                  </p>
                  {guide}
                </div>
                <div class="relative px-8">
                  <ul class="space-y-1.5 py-6" role="list">
                    {data.features.map((feature) => (
                      <li
                        class:list={[
                          'pointer-fine:opacity-70 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-within:opacity-100 flex gap-2 text-sm transition-opacity motion-ui',
                          tier.item,
                        ]}
                      >
                        <span
                          aria-hidden="true"
                          class="flex h-lh shrink-0 items-center"
                        >
                          <SparkIcon
                            class:list={[
                              'size-3 pointer-fine:opacity-0 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-within:opacity-100 transition-opacity motion-ui',
                              tier.mark,
                            ]}
                          />
                        </span>
                        {feature}
                      </li>
                    ))}
                  </ul>
                </div>
                {data.tier === 'featured' ? (
                  <CtaButton href={ctaHref} class="relative mt-auto">
                    Explore this Solution
                  </CtaButton>
                ) : (
                  <CtaButton
                    href={ctaHref}
                    variant="secondary"
                    class="relative mt-auto transition-opacity motion-ui reveal-on-hover"
                  >
                    Explore this Solution
                  </CtaButton>
                )}
              </article>
            );
          })}
        </div>
      </div>
    </Container>
  </div>
</Section>
