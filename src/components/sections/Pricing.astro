---
import CtaButton from '../ui/CtaButton.astro';
import { getCollection } from 'astro:content';
import camera from '../../scripts/pricing-camera.json';
import Container from '../ui/Container.astro';
import SectionFrame from '../ui/SectionFrame.astro';
import SparkIcon from '../ui/SparkIcon.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import GridMark from '../ui/GridMark.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
  emphasis?: string;
  ctaHref?: string;
}
const {
  id = 'engagements',
  label,
  heading,
  emphasis,
  ctaHref = '#contact',
} = Astro.props;
const engagements = (await getCollection('engagements')).sort(
  (a, b) => a.data.order - b.data.order,
);
const tiers = {
  standard: {
    box: 'ease-out-soft transition-opacity duration-300 lg:opacity-90 lg:hover:opacity-100 lg:focus-within:opacity-100',
    name: 'text-white',
    muted: 'text-white/80',
    price: 'text-price text-frost mt-price font-medium',
    mark: 'text-azure',
    term: 'text-azure',
    rule: 'max-lg:border-b border-white/10',
    item: 'text-frost',
  },
  featured: {
    box: 'bg-white z-10 ease-standard origin-(--origin) transition-transform duration-300 hover:scale-103',
    name: 'text-ink',
    muted: 'text-ink',
    price: 'text-price-lg text-ink mt-price-featured font-semibold',
    mark: 'text-signal',
    term: 'text-sky',
    rule: 'border-b border-ink/10 -mx-8 px-8',
    item: 'text-ocean font-medium',
  },
  premium: {
    box: 'ease-out-soft transition-opacity duration-300 lg:opacity-90 lg:hover:opacity-100 lg:focus-within:opacity-100',
    name: 'text-white',
    muted: 'text-white/80',
    price: 'text-price text-frost mt-price font-medium',
    mark: 'text-signal',
    term: 'text-azure',
    rule: 'max-lg:border-b border-white/10',
    item: 'text-frost',
  },
};
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  data-scene-path={JSON.stringify(camera)}
  class="scroll-mt-nav relative z-10 overflow-x-clip text-white"
>
  <SectionFrame inverted />
  <div data-guide class="relative border-t border-white/10">
    <Container class="overflow-y-clip pb-52 lg:pb-72">
      <Eyebrow id={`${id}-label`} inverted>
        {label}
      </Eyebrow>
      <div data-parallax class="translate-y-(--shift) pt-40 lg:pt-60">
        <h3 class="text-section text-center">
          {heading}
          {emphasis && (
            <>
              {' '}
              <strong class="font-normal">{emphasis}</strong>
            </>
          )}
        </h3>
        <div class="lg:grid-rows-offer mt-14 grid gap-6 lg:grid-cols-3 lg:gap-0">
          {engagements.map(({ data }, index) => {
            const tier = tiers[data.tier];
            const first = index === 0;
            const last = index === engagements.length - 1;
            const guide = (
              <>
                {first && (
                  <>
                    <div class="bleed-x absolute bottom-0 h-px bg-white/10 max-lg:hidden" />
                    <GridMark
                      inverted
                      class="absolute top-full left-0 -mt-px max-lg:hidden"
                    />
                  </>
                )}
                {last && (
                  <GridMark
                    inverted
                    class="3xl:block absolute top-full left-full -mt-px -ml-px hidden"
                  />
                )}
              </>
            );
            return (
              <article
                style={
                  data.tier === 'featured' ? '--origin: 50% 46%' : undefined
                }
                class:list={[
                  'group relative flex flex-col text-balance lg:row-span-3 lg:grid lg:grid-rows-subgrid',
                  tier.box,
                ]}
              >
                <div class="relative px-8 pt-11">
                  {data.tier === 'featured' && (
                    <p class="to-ocean-50 text-sky absolute inset-x-0 top-0 bg-linear-to-r from-white text-label px-4 py-2 text-right font-semibold tracking-widest uppercase">
                      Most popular
                    </p>
                  )}
                  <h4 class:list={['text-2xl font-semibold', tier.name]}>
                    {data.name}
                  </h4>
                  <p class:list={['mt-1.5 text-base text-balance', tier.muted]}>
                    {data.audience}
                  </p>
                  <p
                    class:list={['pb-6 tracking-price', tier.price, tier.rule]}
                  >
                    {data.pricePrefix && (
                      <span class="font-light">{data.pricePrefix} </span>
                    )}
                    {data.price}
                    <span
                      class:list={[
                        'mt-3 block text-sm tracking-widest uppercase',
                        tier.term,
                      ]}
                    >
                      {data.duration}
                    </span>
                  </p>
                  {guide}
                </div>
                <div class="relative px-8">
                  <ul class="space-y-1.5 py-6" role="list">
                    {data.features.map((feature) => (
                      <li
                        class:list={[
                          'ease-out-soft pointer-fine:opacity-70 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-within:opacity-100 flex gap-2 text-sm transition-opacity duration-300',
                          tier.item,
                        ]}
                      >
                        <span
                          aria-hidden="true"
                          class="flex h-lh shrink-0 items-center"
                        >
                          <SparkIcon
                            class:list={[
                              'size-3 ease-out-soft pointer-fine:opacity-0 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-within:opacity-100 transition-opacity duration-300',
                              tier.mark,
                            ]}
                          />
                        </span>
                        {feature}
                      </li>
                    ))}
                  </ul>
                </div>
                {data.tier === 'featured' ? (
                  <CtaButton href={ctaHref} class="relative mt-auto">
                    Book a Call with Alex
                  </CtaButton>
                ) : (
                  <CtaButton
                    href={ctaHref}
                    variant="secondary"
                    class="ease-out-soft relative mt-auto transition-opacity duration-300 lg:opacity-0 lg:group-focus-within:opacity-100 lg:group-hover:opacity-100"
                  >
                    Book a Call with Alex
                  </CtaButton>
                )}
              </article>
            );
          })}
        </div>
      </div>
    </Container>
  </div>
</section>

<script>
  import { initParallax } from '../../scripts/parallax';

  for (const element of document.querySelectorAll<HTMLElement>(
    '#engagements [data-parallax]',
  )) {
    initParallax(element, 0.125);
  }
</script>
