---
import { getCollection, render } from 'astro:content';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import SectionFrame from '../ui/SectionFrame.astro';

interface Props {
  id?: string;
  label: string;
  heading: string;
}
const { id = 'faq', label, heading } = Astro.props;
const faqs = await Promise.all(
  (await getCollection('faqs'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (entry) => ({ ...entry, ...(await render(entry)) })),
);
const half = Math.ceil(faqs.length / 2);
const columns = [faqs.slice(0, half), faqs.slice(half)];
---

<section
  id={id}
  aria-labelledby={`${id}-label`}
  class="scroll-mt-nav relative z-10 overflow-x-clip text-white"
>
  <SectionFrame inverted />
  <div data-guide class="relative border-t border-white/10">
    <Container>
      <Eyebrow id={`${id}-label`} inverted>
        {label}
      </Eyebrow>
      <div class="relative pb-40 lg:pb-56">
        <div
          aria-hidden="true"
          class="from-abyss to-abyss/0 absolute inset-0 border-x border-white/10 bg-linear-to-b"
        ></div>
        <h3 class="text-section relative px-8 pt-24 pb-12 lg:pt-32 lg:pb-16">
          {heading}
        </h3>
        <div class="relative grid items-start lg:grid-cols-2">
          {columns.map((column) => (
            <ul role="list">
              {column.map(({ data, Content }) => (
                <li class="group relative pointer-fine:hover:z-20">
                  <div
                    aria-hidden="true"
                    class="ease-out-soft shadow-card bg-space-950/50 backdrop-blur-bar pointer-events-none absolute inset-0 rounded-lg border border-white/15 opacity-0 transition duration-300 group-has-open:opacity-100 pointer-fine:group-hover:-translate-y-lift pointer-fine:group-hover:opacity-100"
                  />
                  <details
                    name="faq"
                    class="details-expand ease-out-soft relative pb-4 transition duration-300 pointer-fine:group-hover:-translate-y-lift"
                  >
                    <summary class="text-frost/80 group-has-open:text-white focus-visible:outline-signal flex min-h-11 cursor-pointer list-none text-balance items-center pr-16 pl-8 pt-8 pb-4 text-lg font-light tracking-tight lg:text-xl transition-colors duration-300 group-hover:text-white focus-visible:outline-2 focus-visible:-outline-offset-2">
                      {data.question}
                    </summary>
                    <div class="text-frost/80 pr-16 pb-4 pl-8 text-base text-pretty prose-links">
                      <Content />
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </Container>
  </div>
</section>
