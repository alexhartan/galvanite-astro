---
import ArtMasks from './ArtMasks.astro';
import { frame, ink, motion, outline, pivot, type Frame } from './kit';

interface Props {
  id: string;
  frames: readonly Frame[];
}
const { id, frames } = Astro.props;
const names = ['a', 'b', 'c'] as const;
const render = (name: string) =>
  Astro.slots.has(name) ? Astro.slots.render(name) : Promise.resolve('');
const content = await Promise.all(names.map((name) => render(name)));
const under = await Promise.all(names.map((name) => render(`${name}-under`)));
---

<svg
  class="absolute top-1/2 left-1/2 -translate-1/2 overflow-visible"
  width="300"
  height="180"
  viewBox="0 0 300 180"
  fill="none"
>
  <ArtMasks id={id} frames={frames} />
  {frames.map(({ x, y, w, h, lift }, index) => (
    <g mask={index < frames.length - 1 ? `url(#${id}-${index})` : undefined}>
      <g transform={`translate(${x} ${y})`}>
        <g class:list={[pivot, lift, motion]}>
          <Fragment set:html={under[index]} />
          <path
            d={frame(w, h)}
            stroke-width="2"
            class:list={[outline, motion]}
          />
          <g stroke-width="2" stroke-linecap="round">
            <path
              d={`M${Math.round(w * 0.12)} 14H${Math.round(w * 0.12 + 36)}`}
              stroke-width="1"
              class:list={[ink, motion]}
            />
            <Fragment set:html={content[index]} />
          </g>
        </g>
      </g>
    </g>
  ))}
</svg>
