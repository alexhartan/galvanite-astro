---
import ArtStack from './ArtStack.astro';
import { ink, motion } from './kit';

const frames = [
  { x: 83, y: 82, w: 120, h: 80, lift: 'group-hover:-translate-x-2' },
  {
    x: 160,
    y: 124,
    w: 60,
    h: 48,
    lift: 'group-hover:translate-x-3 group-hover:-translate-y-2',
  },
];
const line = [ink, motion];
---

<ArtStack id="art-performance" frames={frames}>
  <g slot="a">
    <circle cx="34" cy="48" r="16" class:list={line} />
    <circle
      cx="34"
      cy="48"
      r="16"
      pathLength="100"
      stroke-dasharray="100"
      class="gauge group-hover:gauge-full transform-fill origin-center -rotate-90 stroke-azure-deep group-hover:stroke-sky"
    />
    <path d="M64 40H104M64 50H92M64 60H98" class:list={line} />
  </g>
  <path
    slot="b"
    d="M8 36L18 28L28 32L40 20L52 24"
    stroke-linejoin="round"
    class:list={line}
  />
</ArtStack>
