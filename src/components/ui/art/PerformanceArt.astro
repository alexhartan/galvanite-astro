---
import ArtFrame from './ArtFrame.astro';
import { accent, move, shift } from './tones';

const fill = 'url(#art-performance)';
const rows = [
  { y: 88, featured: false },
  { y: 114, featured: false },
  { y: 62, featured: true },
];
---

<ArtFrame gradient="art-performance">
  <path d="M38 114a44 44 0 0 1 88 0z" fill={fill} stroke="none"></path>
  <path d="M32 106a44 44 0 0 1 66 -38.1" class="stroke-frost/40"></path>
  <path
    d="M98 67.9a44 44 0 0 1 22 38.1"
    class:list={[shift, accent.stroke]}
  ></path>
  <path d="M42 106h4M51 73l2.8 2.8M76 62v4M106 106h4" class="stroke-sky"></path>
  <g
    class:list={[
      move,
      'transform-fill origin-center -rotate-100 group-hover:rotate-0',
    ]}
  >
    <g class="transform-fill motion-safe:group-hover:animate-art-wobble origin-center">
      <circle cx="76" cy="106" r="32" stroke="none"></circle>
      <path d="M76 106l27 -15"></path>
    </g>
  </g>
  <circle cx="76" cy="106" r="4" class="fill-frost" stroke="none"></circle>
  <rect x="160" y="26" width="96" height="22" rx="5"></rect>
  <circle cx="172" cy="36" r="4" class="stroke-sky"></circle>
  <path d="M175 39l3 3M186 37h34" class="stroke-sky"></path>
  {rows.map(({ y, featured }) =>
    featured ? (
      <g class:list={[move, 'translate-y-13 group-hover:translate-y-0']}>
        <rect
          x="166"
          y={y + 6}
          width="96"
          height="20"
          rx="5"
          fill={fill}
          stroke="none"
        />
        <rect
          x="160"
          y={y}
          width="96"
          height="20"
          rx="5"
          class:list={[shift, accent.stroke, 'fill-abyss']}
        />
        <rect
          x="166"
          y={y + 6}
          width="8"
          height="8"
          rx="2"
          class:list={[shift, accent.stroke, accent.fill]}
        />
        <path d={`M182 ${y + 10}h52`} class:list={[shift, accent.stroke]} />
      </g>
    ) : (
      <g class:list={[move, '-translate-y-6.5 group-hover:translate-y-0']}>
        <rect
          x="160"
          y={y}
          width="96"
          height="20"
          rx="5"
          class="stroke-frost/40"
        />
        <rect
          x="166"
          y={y + 6}
          width="8"
          height="8"
          rx="2"
          class="stroke-sky"
        />
        <path d={`M182 ${y + 10}h36`} class="stroke-sky" />
      </g>
    ),
  )}
</ArtFrame>
