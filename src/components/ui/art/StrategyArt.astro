---
import ArtStack from './ArtStack.astro';
import { ink, motion } from './kit';

const frames = [
  {
    x: 83,
    y: 84,
    w: 96,
    h: 70,
    lift: 'group-hover:-translate-x-2 group-hover:-rotate-3',
  },
  {
    x: 122,
    y: 100,
    w: 100,
    h: 72,
    lift: 'group-hover:translate-x-2 group-hover:-translate-y-2',
  },
];
const line = [ink, motion];
const drift = ['transform-fill origin-center', ink, motion];
---

<ArtStack id="art-strategy" frames={frames}>
  <g slot="a" class:list={line}>
    <circle cx="20" cy="34" r="8" />
    <path d="M36 30H76M36 40H62M12 54H80" />
  </g>
  <g slot="b">
    <defs>
      <clipPath id="art-strategy-venn-a">
        <circle cx="42" cy="46" r="13" />
      </clipPath>
      <clipPath id="art-strategy-venn-b">
        <circle cx="58" cy="46" r="13" />
      </clipPath>
    </defs>
    <g clip-path="url(#art-strategy-venn-a)">
      <g clip-path="url(#art-strategy-venn-b)">
        <circle
          cx="50"
          cy="33"
          r="13"
          stroke="none"
          class:list={[
            'fill-azure-deep opacity-0 group-hover:opacity-100',
            motion,
          ]}
        />
      </g>
    </g>
    <circle
      cx="39"
      cy="46"
      r="13"
      class:list={[drift, 'group-hover:translate-x-0.75']}
    />
    <circle
      cx="61"
      cy="46"
      r="13"
      class:list={[drift, 'group-hover:-translate-x-0.75']}
    />
    <circle
      cx="50"
      cy="30"
      r="13"
      class:list={[drift, 'group-hover:translate-y-0.75']}
    />
  </g>
</ArtStack>
