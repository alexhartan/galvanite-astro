---
import ArtFrame from './ArtFrame.astro';
import { accent, flow, pulse, shift } from './tones';

const fill = 'url(#art-strategy)';
const dots = [
  { cx: 58, cy: 44, tx: 46, ty: 30 },
  { cx: 58, cy: 80, tx: 44, ty: 0 },
  { cx: 58, cy: 116, tx: 46, ty: -30 },
];
---

<ArtFrame gradient="art-strategy">
  <circle cx="48" cy="42" r="12" fill={fill} stroke="none"></circle>
  <circle cx="44" cy="38" r="12"></circle>
  <rect x="40" y="34" width="8" height="8" rx="2" class="stroke-sky"></rect>
  <circle cx="48" cy="84" r="12" fill={fill} stroke="none"></circle>
  <circle cx="44" cy="80" r="12"></circle>
  <g class="stroke-sky">
    <circle cx="44" cy="77" r="2.5"></circle>
    <path d="M39 86a5 5 0 0 1 10 0"></path>
  </g>
  <circle cx="48" cy="126" r="12" fill={fill} stroke="none"></circle>
  <circle cx="44" cy="122" r="12"></circle>
  <path d="M44 117v5l3.5 2" class="stroke-sky"></path>
  <path d="M58 44l46 30M58 80h44M58 116l46 -30" class="stroke-azure"></path>
  <g stroke="none">
    {dots.map(({ cx, cy, tx, ty }, index) => (
      <circle
        cx={cx}
        cy={cy}
        r="2.5"
        style={`--tx: ${tx}px; --ty: ${ty}px; --delay: ${index * 0.3}s`}
        class={flow}
      />
    ))}
  </g>
  <g class={pulse}>
    <path
      d="M122 62l18 18l-18 18l-18 -18z"
      class:list={[shift, accent.tint, accent.stroke]}
    ></path>
    <circle
      cx="122"
      cy="80"
      r="3.5"
      stroke="none"
      class:list={[shift, accent.fill]}
    ></circle>
  </g>
  <path
    d="M146 80h22m-5 -5l5 5l-5 5"
    class:list={[shift, accent.stroke]}
  ></path>
  <rect
    x="184"
    y="40"
    width="66"
    height="92"
    rx="6"
    fill={fill}
    stroke="none"
  ></rect>
  <rect x="176" y="32" width="66" height="92" rx="6"></rect>
  <path d="M176 46h66"></path>
  <g class="stroke-sky">
    <path d="M184 39h10M184 88h34M184 96h22"></path>
    <rect
      x="184"
      y="54"
      width="50"
      height="24"
      rx="3"
      class="fill-azure/15"
    ></rect>
  </g>
  <rect
    x="184"
    y="106"
    width="24"
    height="10"
    rx="3"
    class:list={[shift, accent.fill, accent.stroke]}
  ></rect>
</ArtFrame>
