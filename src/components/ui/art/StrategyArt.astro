---
import { Image } from 'astro:assets';
import spark from '../../../assets/benefits/spark.png';

const rings = [0, 1, 0.85, 0.7, 0.55, 0.4, 0.25, 0.1].map(
  (from, index, list) => ({
    r: (51.05 * 1.43 ** index).toFixed(2),
    from,
    to: list[index + 1] ?? 0,
  }),
);
---

<div class="ease-out-soft absolute inset-0 opacity-75 transition-opacity duration-300 group-hover:opacity-100">
  <svg
    class="absolute bottom-0 left-1/2 -translate-x-1/2 overflow-visible"
    width="300"
    height="180"
    viewBox="0 0 300 180"
    fill="none"
  >
    <defs>
      <radialGradient id="art-strategy-ring" cx="0.5" cy="1" r="1">
        <stop offset="0.35" stop-color="currentColor" class="text-azure"></stop>
        <stop
          offset="1"
          stop-color="currentColor"
          stop-opacity="0"
          class="text-azure-deep"
        ></stop>
      </radialGradient>
    </defs>
    {rings.map(({ r, from, to }) => (
      <circle
        cx="150"
        cy={178.5 - Number(r)}
        r={r}
        stroke="url(#art-strategy-ring)"
        stroke-width="3"
        vector-effect="non-scaling-stroke"
        opacity={from}
        style={`--from: ${from}; --to: ${to}`}
        class="transform-fill motion-safe:group-hover:animate-ripple origin-bottom"
      />
    ))}
  </svg>
  <div class="motion-safe:group-hover:animate-hover-float absolute bottom-7 left-1/2 -translate-x-1/2">
    <Image
      src={spark}
      alt=""
      width={47}
      height={47}
      densities={[1, 2]}
      class="-rotate-45"
    />
  </div>
</div>
