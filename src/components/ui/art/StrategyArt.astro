---
import ArtStack from './ArtStack.astro';
import { ink, motion } from './kit';

const frames = [
  {
    x: 83,
    y: 84,
    w: 96,
    h: 70,
    lift: 'group-hover:-translate-x-2 group-hover:-rotate-3',
  },
  {
    x: 122,
    y: 100,
    w: 100,
    h: 72,
    lift: 'group-hover:translate-x-2 group-hover:-translate-y-2',
  },
];
const line = [ink, motion];
const bar = [
  'transform-fill origin-bottom group-hover:scale-y-125',
  ink,
  motion,
];
---

<ArtStack id="art-strategy" frames={frames}>
  <g slot="a" class:list={line}>
    <circle cx="20" cy="34" r="8" />
    <path d="M36 30H76M36 40H62M12 54H80" />
  </g>
  <g slot="b">
    <rect x="12" y="46" width="10" height="14" rx="1" class:list={bar} />
    <rect x="28" y="40" width="10" height="20" rx="1" class:list={bar} />
    <rect x="44" y="32" width="10" height="28" rx="1" class:list={bar} />
    <path d="M64 36H88M64 46H80" class:list={line} />
  </g>
</ArtStack>
