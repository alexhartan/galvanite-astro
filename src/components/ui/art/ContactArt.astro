---
import { ink, motion } from './kit';
---

<svg
  class="absolute top-1/2 left-1/2 -translate-1/2 overflow-visible"
  width="300"
  height="180"
  viewBox="0 0 300 180"
  fill="none"
  stroke-linecap="round"
>
  <g
    class:list={['transform-fill origin-center group-hover:scale-108', motion]}
  >
    <g class="transform-fill origin-center group-hover:motion-safe:animate-art-orbit">
      <path
        d="M152.52 74.93A44.85 44.85 0 0 1 171.03 85.62M183.56 107.31A44.85 44.85 0 0 1 183.56 128.69M171.03 150.38A44.85 44.85 0 0 1 152.52 161.07M127.48 161.07A44.85 44.85 0 0 1 108.97 150.38M96.44 128.69A44.85 44.85 0 0 1 96.44 107.31M108.97 85.62A44.85 44.85 0 0 1 127.48 74.93"
        stroke-width="1.5"
        class:list={[ink, motion]}
      />
      <g stroke-width="2.5" class="stroke-azure-deep">
        <circle cx="140.00" cy="73.15" r="5.17" />
        <circle cx="178.84" cy="95.58" r="5.17" />
        <circle cx="178.84" cy="140.42" r="5.17" />
        <circle cx="140.00" cy="162.85" r="5.17" />
        <circle cx="101.16" cy="140.42" r="5.17" />
        <circle cx="101.16" cy="95.58" r="5.17" />
      </g>
    </g>
  </g>
  <g
    class:list={['transform-fill origin-center group-hover:scale-112', motion]}
  >
    <rect
      x="118.15"
      y="96.15"
      width="43.7"
      height="43.7"
      rx="5.17"
      stroke-width="2.5"
      class="fill-white stroke-sky"
    />
    <g stroke-width="2.5" class="stroke-azure-deep">
      <circle cx="140" cy="111.1" r="6.9" />
      <path d="M127.35 132.95C127.35 125.47 132.53 121.45 140 121.45C147.47 121.45 152.65 125.47 152.65 132.95" />
    </g>
  </g>
</svg>
