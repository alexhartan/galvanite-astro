---
import { ink, motion } from './kit';
---

<svg
  class="absolute top-1/2 left-1/2 -translate-1/2 overflow-visible"
  width="300"
  height="180"
  viewBox="0 0 300 180"
  fill="none"
  stroke-linecap="round"
>
  <g
    class:list={['transform-fill origin-center group-hover:scale-108', motion]}
  >
    <g class="transform-fill origin-center group-hover:motion-safe:animate-art-orbit">
      <path
        d="M150.89 87.55A39 39 0 0 1 166.99 96.84M177.88 115.71A39 39 0 0 1 177.88 134.29M166.99 153.16A39 39 0 0 1 150.89 162.45M129.11 162.45A39 39 0 0 1 113.01 153.16M102.12 134.29A39 39 0 0 1 102.12 115.71M113.01 96.84A39 39 0 0 1 129.11 87.55"
        stroke-width="1.5"
        class:list={[ink, motion]}
      />
      <g stroke-width="2.5" class="stroke-azure-deep">
        <circle cx="140.00" cy="86.00" r="4.5" />
        <circle cx="173.77" cy="105.50" r="4.5" />
        <circle cx="173.77" cy="144.50" r="4.5" />
        <circle cx="140.00" cy="164.00" r="4.5" />
        <circle cx="106.23" cy="144.50" r="4.5" />
        <circle cx="106.23" cy="105.50" r="4.5" />
      </g>
    </g>
  </g>
  <g
    class:list={['transform-fill origin-center group-hover:scale-115', motion]}
  >
    <rect
      x="118"
      y="103"
      width="44"
      height="44"
      rx="5"
      stroke-width="2.5"
      class="fill-white stroke-sky"
    />
    <g stroke-width="2.5" class="stroke-azure-deep">
      <circle cx="140" cy="118" r="7" />
      <path d="M127 140C127 132 132.5 128 140 128C147.5 128 153 132 153 140" />
    </g>
  </g>
</svg>
