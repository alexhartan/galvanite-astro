---
import ArtStack from './ArtStack.astro';
import { ink, motion, outline } from './kit';

const frames = [
  {
    x: 149,
    y: 166,
    w: 68,
    h: 6,
    bare: true,
    d: 'M2 0.5H60L67.5 3L60 5.5H2C1.172 5.5 0.5 4.828 0.5 4V2C0.5 1.172 1.172 0.5 2 0.5Z',
    lift: 'group-hover:translate-x-2',
  },
  {
    x: 107,
    y: 88,
    w: 110,
    h: 70,
    bare: true,
    lift: 'group-hover:-translate-y-1.5',
  },
  {
    x: 83,
    y: 97,
    w: 30,
    h: 52,
    bare: true,
    d: 'M1 1V51H29Z',
    lift: 'group-hover:-translate-x-1.5 group-hover:-translate-y-1.5',
  },
];
const steps = [
  'group-hover:delay-0',
  'group-hover:delay-75',
  'group-hover:delay-150',
  'group-hover:delay-200',
  'group-hover:delay-300',
];
const fill = 'fill-azure-deep opacity-0 group-hover:opacity-100';
---

<ArtStack id="art-process" frames={frames}>
  <path slot="a" d="M8 0.5V5.5" stroke-width="1" class:list={[ink, motion]} />
  <g slot="b">
    <g class="ease-standard transition-transform duration-1000 group-hover:translate-x-23.5 motion-reduce:transition-none">
      <path d="M8 8V62" stroke-width="1" class:list={[ink, motion]} />
    </g>
    {steps.map((delay, index) => (
      <>
        <rect
          x={12 + index * 14}
          y={12 + index * 10}
          width="30"
          height="6"
          rx="2"
          class:list={['fill-deep-950', ink, motion]}
        />
        <rect
          x={12 + index * 14}
          y={12 + index * 10}
          width="30"
          height="6"
          rx="2"
          stroke="none"
          class:list={[fill, motion, delay]}
        />
      </>
    ))}
  </g>
  <path
    slot="c"
    d="M7 18V45H22Z"
    stroke-linejoin="round"
    class:list={[outline, 'fill-none', motion]}
  />
</ArtStack>
