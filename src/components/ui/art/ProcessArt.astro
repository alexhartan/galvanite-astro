---
import ArtStack from './ArtStack.astro';
import { ink, motion, outline } from './kit';

const frames = [
  {
    x: 83,
    y: 96,
    w: 18,
    h: 76,
    bare: true,
    lift: 'group-hover:-translate-x-1 group-hover:-rotate-6',
  },
  {
    x: 229,
    y: 100,
    w: 10,
    h: 63,
    bare: true,
    lift: 'group-hover:translate-x-1 group-hover:rotate-12',
  },
  { x: 109, y: 88, w: 112, h: 84, lift: 'group-hover:-translate-y-1' },
];
const steps = [
  'group-hover:delay-0',
  'group-hover:delay-75',
  'group-hover:delay-150',
  'group-hover:delay-200',
  'group-hover:delay-300',
];
const fill = 'fill-azure-deep opacity-0 group-hover:opacity-100';
const ticks = Array.from(
  { length: 8 },
  (_, i) => `M1 ${10 + i * 8}H${i % 2 ? 6 : 10}`,
).join('');
---

<ArtStack id="art-process" frames={frames}>
  <path slot="a" d={ticks} stroke-width="1" class:list={[ink, motion]} />
  <g slot="b">
    <path d="M1 14H9" class:list={[ink, motion]} />
    <path
      d="M1 62L5 72L9 62"
      stroke-linejoin="round"
      class:list={[outline, 'fill-none', motion]}
    />
  </g>
  <g slot="c">
    <path
      d="M10 22V74"
      stroke-width="1"
      class:list={[
        'stroke-ink/60 transition-transform duration-1000 ease-standard group-hover:translate-x-23 motion-reduce:transition-none',
      ]}
    />
    {steps.map((delay, index) => (
      <>
        <rect
          x={12 + index * 14}
          y={26 + index * 10}
          width="30"
          height="6"
          rx="2"
          class:list={['fill-deep-950', ink, motion]}
        />
        <rect
          x={12 + index * 14}
          y={26 + index * 10}
          width="30"
          height="6"
          rx="2"
          stroke="none"
          class:list={[fill, motion, delay]}
        />
      </>
    ))}
  </g>
</ArtStack>
