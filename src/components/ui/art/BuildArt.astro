---
import ArtStack from './ArtStack.astro';
import { ink, motion, solid } from './kit';

const frames = [
  { x: 83, y: 78, w: 120, h: 84, lift: 'group-hover:-translate-x-2' },
  {
    x: 150,
    y: 116,
    w: 70,
    h: 56,
    lift: 'group-hover:translate-x-3 group-hover:-translate-y-2',
  },
];
const line = [ink, motion];
---

<ArtStack id="art-build" frames={frames}>
  <path
    slot="a"
    d="M14 30H60M22 40H84M22 50H70M30 60H96M22 70H56"
    class:list={line}
  />
  <g slot="b">
    <path d="M10 28L16 33L10 38" stroke-linejoin="round" class:list={line} />
    <rect
      x="22"
      y="28"
      width="6"
      height="10"
      stroke="none"
      class:list={[solid, 'motion-safe:group-hover:animate-art-blink', motion]}
    />
  </g>
</ArtStack>
