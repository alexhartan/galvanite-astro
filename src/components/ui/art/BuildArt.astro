---
import ArtFrame from './ArtFrame.astro';
import { accent, pulse, shift } from './tones';
---

<ArtFrame gradient="art-build">
  <rect
    x="56"
    y="32"
    width="160"
    height="110"
    rx="8"
    fill="url(#art-build)"
    stroke="none"
  ></rect>
  <rect x="48" y="24" width="160" height="110" rx="8"></rect>
  <path d="M48 44h160M58 34h2M66 34h2M74 34h2"></path>
  <g stroke-width="3">
    <path d="M62 62h40M62 122h22"></path>
    <path d="M74 74h58M74 86h44M74 110h36" class="stroke-sky"></path>
    <path d="M86 98h62" class="stroke-azure"></path>
    <path d="M138 74h22" class:list={[shift, accent.stroke]}></path>
    <path
      d="M92 118v8"
      class="stroke-signal opacity-0 motion-safe:group-hover:animate-art-blink"
    ></path>
  </g>
  <g class:list={[pulse, shift, accent.stroke]}>
    <circle cx="208" cy="112" r="24" class="fill-abyss"></circle>
    <circle cx="208" cy="112" r="24" class:list={[shift, accent.tint]}></circle>
    <circle cx="199" cy="112" r="5"></circle>
    <path d="M204 112h15M214 112v5M219 112v4"></path>
  </g>
</ArtFrame>
