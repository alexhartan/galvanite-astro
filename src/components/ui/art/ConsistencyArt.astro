---
import ArtStack from './ArtStack.astro';
import { ink, motion, outline } from './kit';

const frames = [
  {
    x: 120,
    y: 76,
    w: 120,
    h: 76,
    lift: 'group-hover:translate-x-2 group-hover:-translate-y-1',
  },
  { x: 83, y: 118, w: 80, h: 50, lift: 'group-hover:-translate-x-2' },
  { x: 149, y: 112, w: 28, h: 60, lift: 'group-hover:-translate-y-3' },
];
const line = [ink, motion];
const edge = [outline, 'fill-none', motion];
---

<ArtStack id="art-consistency" frames={frames}>
  <path
    slot="a-under"
    d="M60 76V86M44 87H76"
    stroke-width="2.5"
    stroke-linecap="round"
    class:list={edge}
  />
  <g slot="a" class:list={line}>
    <path d="M14 34H100M14 44H76" />
    <rect x="14" y="56" width="30" height="8" rx="2" />
  </g>
  <path
    slot="b-under"
    d="M-6 54H86"
    stroke-width="2.5"
    stroke-linecap="round"
    class:list={edge}
  />
  <g slot="b" class:list={line}>
    <path d="M10 24H66M10 32H50" />
    <rect x="10" y="38" width="20" height="6" rx="2" />
  </g>
  <g slot="c" class:list={line}>
    <path d="M5 28H23M5 36H18" />
    <rect x="5" y="44" width="12" height="6" rx="2" />
  </g>
</ArtStack>
