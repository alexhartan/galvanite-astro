---
import ArtFrame from './ArtFrame.astro';
import { accent, flow, pulse, shift } from './tones';

const fill = 'url(#art-consistency)';
const mark = [shift, accent.mark, accent.stroke];
const dots = [
  { cx: 120, cy: 80, x1: -13, tx: -26, ty: 0 },
  { cx: 160, cy: 70, x1: 20, tx: 44, ty: -25 },
  { cx: 160, cy: 90, x1: 20, tx: 34, ty: 26 },
];
---

<ArtFrame gradient="art-consistency">
  <path
    d="M120 80h-26M160 70h14a6 6 0 0 0 6 -6v-13a6 6 0 0 1 6 -6h18M160 90h14a6 6 0 0 1 6 6v14a6 6 0 0 0 6 6h8"
    class="stroke-azure"
  ></path>
  <g class={pulse}>
    <rect
      x="126"
      y="66"
      width="40"
      height="40"
      rx="8"
      fill={fill}
      stroke="none"
    ></rect>
    <rect
      x="120"
      y="60"
      width="40"
      height="40"
      rx="8"
      class:list={[shift, accent.tint, accent.stroke]}
    ></rect>
    <circle
      cx="140"
      cy="80"
      r="6"
      stroke="none"
      class:list={[shift, accent.fill]}
    ></circle>
  </g>
  <rect
    x="26"
    y="56"
    width="76"
    height="60"
    rx="6"
    fill={fill}
    stroke="none"
  ></rect>
  <rect x="18" y="48" width="76" height="60" rx="6"></rect>
  <path d="M18 62h76M26 55h2M33 55h2"></path>
  <path d="M44 74h36M44 80h22M26 94h52" class="stroke-sky"></path>
  <rect
    x="212"
    y="24"
    width="34"
    height="58"
    rx="6"
    fill={fill}
    stroke="none"
  ></rect>
  <rect x="204" y="16" width="34" height="58" rx="6"></rect>
  <path d="M217 23h8"></path>
  <path d="M212 52h18M212 59h12" class="stroke-sky"></path>
  <rect
    x="202"
    y="104"
    width="64"
    height="40"
    rx="6"
    fill={fill}
    stroke="none"
  ></rect>
  <rect x="194" y="96" width="64" height="40" rx="6"></rect>
  <path d="M220 108h28M220 114h16M203 126h44" class="stroke-sky"></path>
  <circle cx="32" cy="76" r="5" class:list={mark}></circle>
  <circle cx="221" cy="38" r="5" class:list={mark}></circle>
  <circle cx="208" cy="110" r="5" class:list={mark}></circle>
  <g stroke="none">
    {dots.map(({ cx, cy, x1, tx, ty }, index) => (
      <circle
        cx={cx}
        cy={cy}
        r="2.5"
        style={`--x1: ${x1}px; --tx: ${tx}px; --ty: ${ty}px; --delay: ${index * 0.3}s`}
        class={flow}
      />
    ))}
  </g>
</ArtFrame>
