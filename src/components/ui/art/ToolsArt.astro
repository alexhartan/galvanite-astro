---
import ArtStack from './ArtStack.astro';
import { ink, motion } from './kit';

const frames = [
  {
    x: 83,
    y: 80,
    w: 110,
    h: 80,
    lift: 'group-hover:-translate-x-1 group-hover:-rotate-6',
  },
  { x: 95, y: 86, w: 110, h: 80, lift: 'group-hover:-translate-y-2' },
  {
    x: 107,
    y: 92,
    w: 110,
    h: 80,
    lift: 'group-hover:translate-x-4 group-hover:rotate-6',
  },
];
const line = [ink, motion];
---

<ArtStack id="art-tools" frames={frames}>
  <path slot="a" d="M14 34H84M14 44H64" class:list={line} />
  <g slot="b" class:list={line}>
    <circle cx="21" cy="42" r="7" />
    <circle cx="41" cy="42" r="7" />
    <circle cx="61" cy="42" r="7" />
  </g>
  <g slot="c" class:list={line}>
    <path d="M14 34H96M14 44H76" />
    <rect x="14" y="58" width="28" height="10" rx="2" />
  </g>
</ArtStack>
