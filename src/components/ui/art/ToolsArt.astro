---
const spark =
  'M0.619301 8.8391C-0.206831 8.69331 -0.206833 7.50786 0.619299 7.36207L3.24881 6.89804C5.11118 6.56939 6.56929 5.11128 6.89794 3.24891L7.36197 0.619405C7.50776 -0.206728 8.69321 -0.20673 8.839 0.619403L9.30303 3.24891C9.63168 5.11128 11.0898 6.56939 12.9522 6.89804L15.5817 7.36207C16.4078 7.50786 16.4078 8.69331 15.5817 8.8391L12.9522 9.30313C11.0898 9.63178 9.63168 11.0899 9.30303 12.9523L8.839 15.5818C8.69321 16.4079 7.50776 16.4079 7.36197 15.5818L6.89794 12.9523C6.56929 11.0899 5.11118 9.63178 3.24881 9.30313L0.619301 8.8391Z';
const flips = ['', 'scale(1 -1)', 'scale(-1 1)', 'scale(-1)'];
const sparks = [
  {
    id: 'art-tools-spark-cool',
    layer: 'opacity-100 group-hover:opacity-0',
    stops: [
      { offset: '0.15', tone: 'text-white' },
      { offset: '0.35', tone: 'text-frost' },
      { offset: '1', tone: 'text-azure' },
    ],
  },
  {
    id: 'art-tools-spark-warm',
    layer: 'opacity-0 group-hover:opacity-100',
    stops: [
      { offset: '0.25', tone: 'text-white' },
      { offset: '1', tone: 'text-signal' },
    ],
  },
];
const motion =
  'ease-standard transition duration-500 motion-reduce:transition-none';
const card =
  'M4 1.5H106C107.381 1.5 108.5 2.61929 108.5 4V76C108.5 77.3807 107.381 78.5 106 78.5H4C2.61929 78.5 1.5 77.3807 1.5 76V4C1.5 2.61929 2.61929 1.5 4 1.5Z';
---

<svg
  class="absolute top-1/2 left-1/2 -translate-1/2 overflow-visible"
  width="300"
  height="180"
  viewBox="0 0 300 180"
  fill="none"
>
  <defs>
    <linearGradient
      id="art-tools-card"
      x1="55"
      y1="80"
      x2="55"
      y2="0"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="currentColor" class="text-azure"></stop>
      <stop offset="1" stop-color="currentColor" class="text-ink"></stop>
    </linearGradient>
    <clipPath id="art-tools-spark-clip">
      <path d={spark}></path>
    </clipPath>
    {sparks.map(({ id, stops }) => (
      <linearGradient
        id={id}
        x1="0"
        y1="0"
        x2="500"
        y2="500"
        gradientUnits="userSpaceOnUse"
      >
        {stops.map(({ offset, tone }) => (
          <stop offset={offset} stop-color="currentColor" class={tone} />
        ))}
      </linearGradient>
    ))}
  </defs>
  <g transform="translate(83 78)">
    <g
      class:list={[
        'transform-fill origin-bottom group-hover:-translate-x-1 group-hover:-rotate-6',
        motion,
      ]}
    >
      <path
        d={card}
        stroke="url(#art-tools-card)"
        stroke-width="3"
        class="fill-deep-950"
      ></path>
      <text x="14" y="50" class="fill-azure text-3xl font-light tracking-tight">
        Aa
      </text>
      <path
        d="M68 30h28M68 40h20M68 50h24"
        stroke-width="2"
        class="stroke-azure-deep"
      ></path>
    </g>
  </g>
  <g transform="translate(95 85)">
    <g
      class:list={[
        'transform-fill origin-bottom group-hover:-translate-y-2',
        motion,
      ]}
    >
      <path
        d={card}
        stroke="url(#art-tools-card)"
        stroke-width="3"
        class="fill-deep-950"
      ></path>
      <circle cx="26" cy="38" r="10" class="fill-azure"></circle>
      <circle cx="55" cy="38" r="10" class="fill-sky"></circle>
      <circle cx="84" cy="38" r="10" class="fill-frost"></circle>
      <path d="M16 62h78" stroke-width="2" class="stroke-azure-deep"></path>
    </g>
  </g>
  <g transform="translate(107 92)">
    <g
      class:list={[
        'transform-fill origin-bottom group-hover:translate-x-4 group-hover:rotate-6',
        motion,
      ]}
    >
      <path
        d={card}
        stroke="url(#art-tools-card)"
        stroke-width="3"
        class="fill-deep-950"
      ></path>
      <path
        d="M14 20h46M14 32h70M14 42h58"
        stroke-width="2"
        class="stroke-azure-deep"
      ></path>
      <rect
        x="14"
        y="56"
        width="30"
        height="10"
        rx="2"
        class="fill-azure"
      ></rect>
      <g transform="translate(86 52)">
        <g
          class:list={[
            'transform-fill origin-center group-hover:scale-150',
            motion,
          ]}
        >
          {sparks.map(({ id, layer }) => (
            <g
              clip-path="url(#art-tools-spark-clip)"
              class:list={[layer, motion]}
            >
              <g transform="matrix(0 0.00809957 -0.00809957 0 8.10001 8.10102)">
                {flips.map((flip) => (
                  <rect
                    x="-247"
                    y="-247"
                    width="1332.800"
                    height="1332.810"
                    transform={flip || undefined}
                    fill={`url(#${id})`}
                  />
                ))}
              </g>
            </g>
          ))}
        </g>
      </g>
    </g>
  </g>
</svg>
