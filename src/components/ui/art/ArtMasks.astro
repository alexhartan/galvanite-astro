---
import { frame, motion, pivot, type Frame } from './kit';

interface Props {
  id: string;
  frames: readonly Frame[];
}
const { id, frames } = Astro.props;
---

<defs>
  {frames.slice(0, -1).map((_, index) => (
    <mask
      id={`${id}-${index}`}
      maskUnits="userSpaceOnUse"
      x="0"
      y="0"
      width="300"
      height="180"
    >
      <rect width="300" height="180" fill="white" />
      {frames.slice(index + 1).map(({ x, y, w, h, lift }) => (
        <g transform={`translate(${x} ${y})`}>
          <g class:list={[pivot, lift, motion]}>
            <path
              d={frame(w, h)}
              fill="black"
              stroke="black"
              stroke-width="16"
            />
          </g>
        </g>
      ))}
    </mask>
  ))}
</defs>
