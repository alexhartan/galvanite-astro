---
interface Props {
  name: string;
  value: string;
  size?: 'md' | 'sm';
}
const { name, value, size = 'md' } = Astro.props;
const box = size === 'sm' ? 'size-4' : 'size-6';
---

<span
  class:list={['relative flex shrink-0', size === 'sm' ? 'size-4' : 'size-6']}
>
  <input
    type="checkbox"
    name={name}
    value={value}
    class:list={[
      'peer border-2 border-line-control group-hover:border-glacier checked:border-glacier focus-visible:outline-ocean rounded-control motion-ui focus-ring cursor-pointer appearance-none bg-white transition-colors',
      box,
    ]}
  />
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="text-azure-deep pointer-events-none absolute inset-0"
  >
    <path
      d="M6 12.5l4 4 8-9"
      pathLength="1"
      class="dash-hidden group-has-checked:dash-shown"
    />
  </svg>
</span>
