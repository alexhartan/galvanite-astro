---
import GridMark from './GridMark.astro';

interface Props {
  href: string;
  class?: string;
  link?: string;
  mark?: string;
  variant?: 'primary' | 'secondary';
}
const {
  href,
  class: className,
  link = 'h-12',
  mark = 'text-ink/30',
  variant = 'primary',
} = Astro.props;
const tone = {
  primary: { base: 'bg-signal text-ink', fill: 'bg-space-900' },
  secondary: { base: 'bg-ink/60 text-frost', fill: 'bg-ink' },
}[variant];
const motion =
  'ease-standard transition duration-300 motion-reduce:transition-none';
---

<span class:list={['group/cta flex', className]}>
  <span
    aria-hidden="true"
    class:list={['pointer-events-none absolute inset-0']}
  >
    <GridMark class:list={[mark, 'scale-75 absolute top-0 left-0']} />
    <GridMark class:list={[mark, 'scale-75 absolute top-full left-0 -mt-px']} />
  </span>
  <span
    aria-hidden="true"
    class:list={['pointer-events-none absolute inset-0']}
  >
    <GridMark class:list={[mark, 'scale-75 absolute top-0 left-full -ml-px']} />
    <GridMark
      class:list={[mark, 'absolute top-full left-full -mt-px -ml-px scale-75']}
    />
  </span>
  <a
    href={href}
    class:list={[
      'relative isolate z-10 flex w-full items-center justify-center font-semibold group-hover/cta:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current',
      tone.base,
      motion,
      link,
    ]}
  >
    <span
      aria-hidden="true"
      class:list={[
        'absolute inset-0 -z-10 origin-left scale-x-0 group-hover/cta:scale-x-100 group-focus-within/cta:scale-x-100',
        tone.fill,
        motion,
      ]}
    ></span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 ring-1 ring-white/10 ring-inset"
    ></span>
    <slot />
  </a>
</span>
