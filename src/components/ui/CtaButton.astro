---
interface Props {
  href: string;
  class?: string;
  link?: string;
  variant?: 'primary' | 'secondary';
}
const {
  href,
  class: className,
  link = 'h-12',
  variant = 'primary',
} = Astro.props;
const tone = {
  primary: { base: 'bg-signal text-ink', fill: 'bg-space-900' },
  secondary: { base: 'bg-ink/60 text-frost', fill: 'bg-space-900' },
}[variant];
const motion =
  'ease-in-out-soft transition duration-300 motion-reduce:transition-none';
---

<span class:list={['group/cta flex', className]}>
  <a
    href={href}
    class:list={[
      'relative isolate z-10 flex w-full items-center justify-center font-semibold group-hover/cta:text-white focus-visible:outline-current focus-ring',
      tone.base,
      motion,
      link,
    ]}
  >
    <span
      aria-hidden="true"
      class:list={[
        'absolute inset-0 -z-10 origin-left scale-x-0 group-hover/cta:scale-x-100 group-focus-within/cta:scale-x-100',
        tone.fill,
        motion,
      ]}
    ></span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 ring-1 ring-line-dark ring-inset"
    ></span>
    <slot />
  </a>
</span>
