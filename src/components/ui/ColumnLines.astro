---
import GridMark from './GridMark.astro';

interface Props {
  columns: string[];
  class?: string;
  line?: string;
  mark?: string;
  inverted?: boolean;
}
const { columns, class: className, line, mark, inverted = false } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={['pointer-events-none absolute inset-0 grid', className]}
>
  <GridMark inverted={inverted} class:list={['absolute top-0 left-0', mark]} />
  {columns.map((column) => (
    <div class:list={['relative', column]}>
      <div
        class:list={[
          inverted ? 'from-line-dark' : 'from-line',
          'to-transparent absolute inset-y-0 left-full w-px bg-linear-to-b from-50%',
          line,
        ]}
      />
      <GridMark
        inverted={inverted}
        class:list={['absolute top-0 left-full', mark]}
      />
    </div>
  ))}
</div>
