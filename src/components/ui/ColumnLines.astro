---
import GridMark from './GridMark.astro';

interface Props {
  columns: string[];
  class?: string;
  line?: string;
  mark?: string;
}
const { columns, class: className, line, mark } = Astro.props;
---

<div
  aria-hidden="true"
  class:list={['pointer-events-none absolute inset-0 grid', className]}
>
  <GridMark class:list={['absolute top-0 left-0', mark]} />
  {columns.map((column) => (
    <div class:list={['relative', column]}>
      <div
        class:list={[
          'from-ink/10 to-ink/0 absolute inset-y-0 left-full w-px bg-linear-to-b from-50%',
          line,
        ]}
      />
      <GridMark class:list={['absolute top-0 left-full', mark]} />
    </div>
  ))}
</div>
