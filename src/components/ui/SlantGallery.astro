---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import scroll3 from '../../assets/cta/scroll3.png';
import scroll4 from '../../assets/cta/scroll4.png';
import scroll41 from '../../assets/cta/scroll4-1.png';
import scroll42 from '../../assets/cta/scroll4-2.png';
import scroll43 from '../../assets/cta/scroll4-3.png';
import scroll6 from '../../assets/cta/scroll6.png';
import scroll61 from '../../assets/cta/scroll6-1.png';
import scroll62 from '../../assets/cta/scroll6-2.png';
import scroll63 from '../../assets/cta/scroll6-3.png';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const columns: { motion: string; tiles: ImageMetadata[] }[] = [
  {
    motion: 'motion-safe:animate-marquee-up',
    tiles: [scroll3, scroll4, scroll42, scroll61, scroll41],
  },
  {
    motion: 'motion-safe:animate-marquee-down',
    tiles: [scroll63, scroll62, scroll43, scroll6],
  },
];
const ease = 'ease-out-expo duration-700 motion-reduce:transition-none';
---

<div aria-hidden="true" class:list={['absolute inset-y-0', className]}>
  <div class="flex h-full -skew-x-15 gap-8">
    {columns.map(({ motion, tiles }) => (
      <div class="flex-1">
        <div data-gallery-track class:list={['flex flex-col', motion]}>
          {[...tiles, ...tiles].map((tile) => (
            <div class="group/tile relative mb-8 aspect-square w-full shrink-0">
              <div
                class:list={[
                  'tile-shadow absolute inset-0 opacity-0 transition-opacity group-hover/tile:opacity-100',
                  ease,
                ]}
              />
              <div
                class:list={[
                  'border-sky/25 bg-space-800 relative size-full overflow-hidden border-r border-b transition-transform group-hover/tile:-translate-x-2 group-hover/tile:-translate-y-2',
                  ease,
                ]}
              >
                <Image
                  src={tile}
                  alt=""
                  format="webp"
                  widths={[320, 480, 640, 800]}
                  sizes="(min-width: 1024px) 26vw, 1px"
                  quality={72}
                  draggable="false"
                  class="absolute inset-0 size-full skew-x-15 scale-130 object-cover"
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  import { initGallery } from '../../scripts/gallery';

  document
    .querySelectorAll<HTMLElement>('[data-gallery-track]')
    .forEach((track) => initGallery(track));
</script>
