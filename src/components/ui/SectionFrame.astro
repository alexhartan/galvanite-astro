---
import Container from './Container.astro';
import GridMark from './GridMark.astro';

interface Props {
  inverted?: boolean;
  bottom?: boolean;
  edge?: boolean | 'always';
  top?: boolean;
  markRight?: boolean;
  class?: string;
}
const {
  inverted = false,
  bottom = false,
  edge = true,
  top = true,
  markRight = false,
  class: className,
} = Astro.props;
const line = inverted ? 'bg-line-dark' : 'bg-line';
const right = {
  always: '',
  true: '',
  false: 'hidden',
}[String(edge) as 'always' | 'true' | 'false'];
const mark = markRight ? '' : right;
---

<Container class:list={['pointer-events-none absolute inset-0', className]}>
  <div class:list={['left-gutter absolute inset-y-0 w-px', line]}></div>
  <div class:list={[right, 'right-gutter absolute inset-y-0 w-px', line]}></div>
  {top && (
    <>
      <GridMark inverted={inverted} class="left-gutter absolute top-0" />
      <GridMark
        inverted={inverted}
        class:list={[mark, 'right-gutter absolute top-0 translate-x-1.25']}
      />
    </>
  )}
  {bottom && (
    <>
      <GridMark
        inverted={inverted}
        class="left-gutter absolute bottom-0 translate-y-1.25"
      />
      <GridMark
        inverted={inverted}
        class:list={[
          mark,
          'right-gutter absolute bottom-0 translate-x-1.25 translate-y-1.25',
        ]}
      />
    </>
  )}
</Container>
