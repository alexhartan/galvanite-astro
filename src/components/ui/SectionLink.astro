---
interface Props {
  href: string;
  label: string;
  position: number;
  dark?: boolean;
}
const { href, label, position, dark = false } = Astro.props;
---

<div
  data-section-link={href}
  class="pointer-events-none absolute inset-x-0 top-(--top) z-20 h-(--height) pb-(--offset) max-lg:hidden"
  style={`--slot: ${position}`}
>
  <div class="h-(--lead)"></div>
  <a
    href={href}
    class:list={[
      dark ? 'text-tone' : 'text-azure-deep data-current:text-ocean',
      'section-link ease-out-soft text-nav-label pointer-events-auto sticky ml-5 block w-fit whitespace-nowrap opacity-80 transition-[opacity,color] duration-200 hover:opacity-100 focus-visible:outline-2 focus-visible:outline-current data-current:opacity-100',
    ]}
  >
    {label}
  </a>
</div>

<script>
  const main = document.querySelector<HTMLElement>('main');
  const links = [
    ...document.querySelectorAll<HTMLElement>('[data-section-link]'),
  ].flatMap((track) => {
    const section = document.querySelector<HTMLElement>(
      track.dataset.sectionLink ?? '',
    );
    const label = section?.querySelector<HTMLElement>('[data-eyebrow]');
    const anchor = track.querySelector('a');
    return section && label && anchor
      ? [{ track, section, label, anchor }]
      : [];
  });
  const nav = () =>
    document.querySelector('header')?.getBoundingClientRect().bottom ?? 0;

  const measure = () => {
    const origin = main?.getBoundingClientRect().top ?? 0;
    const pitch =
      1.5 * parseFloat(getComputedStyle(document.documentElement).fontSize);
    let base = 0;
    links.forEach(({ track, section, label }, index) => {
      const box = section.getBoundingClientRect();
      const offset = label.getBoundingClientRect().top - box.top;
      const start = box.top - origin + offset;
      if (index === 0) base = start;
      const top = Math.min(base + index * pitch, start);
      track.style.setProperty('--offset', `${offset}px`);
      track.style.setProperty('--top', `${top}px`);
      track.style.setProperty('--lead', `${start - top}px`);
      track.style.setProperty('--height', `${box.bottom - origin - top}px`);
    });
    highlight();
  };

  let frame = 0;
  const highlight = () => {
    frame = 0;
    const line = nav();
    const view = window.innerHeight - line;
    let current = -1;
    let best = 0.5;
    links.forEach(({ section }, index) => {
      const box = section.getBoundingClientRect();
      const seen =
        Math.min(box.bottom, window.innerHeight) - Math.max(box.top, line);
      const ratio = seen / Math.min(box.height, view);
      if (ratio > best) {
        best = ratio;
        current = index;
      }
    });
    const fade = document.querySelector<HTMLElement>('[data-fade]');
    links.forEach(({ anchor }, index) => {
      anchor.toggleAttribute('data-current', index === current);
      if (!fade) return;
      const box = anchor.getBoundingClientRect();
      const y = box.top + box.height / 2;
      const opacity = Number(fade.style.getPropertyValue('--fade') || 1);
      const tone = y < fade.getBoundingClientRect().bottom ? 0 : 1 - opacity;
      anchor.style.setProperty('--tone', tone.toFixed(3));
    });
  };

  const observer = new ResizeObserver(measure);
  for (const { section } of links) {
    observer.observe(section);
    const guide = section.querySelector('[data-guide]');
    if (guide) observer.observe(guide);
  }
  window.addEventListener(
    'scroll',
    () => {
      frame ||= requestAnimationFrame(highlight);
    },
    { passive: true },
  );
  document.fonts.ready.then(measure);
</script>
