---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

interface Props {
  class?: string;
  large?: boolean;
}
const { class: className, large = false } = Astro.props;
const size = large ? { height: 90, class: 'h-22.5 w-auto' } : { height: 80, class: 'h-20 w-auto' };
const clients = (
  await getCollection('clients', ({ data }) => !data.hidden)
).sort((a, b) => a.data.order - b.data.order);
---

<div class={className} aria-label="Clients" role="group">
  <div
    class:list={[
      large
        ? 'motion-safe:animate-marquee-slow'
        : 'motion-safe:animate-marquee',
      'flex w-max',
    ]}
  >
    {[0, 1].map((copy) => (
      <ul
        class="flex shrink-0 items-center gap-10 pr-10"
        aria-hidden={copy === 1 ? 'true' : undefined}
      >
        {clients.map(({ data }) => (
          <li class="shrink-0">
            <Image
              src={data.logo}
              alt={copy === 0 ? data.name : ''}
              height={size.height}
              densities={[1, 2]}
              class={size.class}
            />
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
