---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const clients = (
  await getCollection('clients', ({ data }) => !data.hidden)
).sort((a, b) => a.data.order - b.data.order);
---

<div class={className} aria-label="Clients" role="group">
  <div class="motion-safe:animate-marquee flex w-max">
    {[0, 1].map((copy) => (
      <ul
        class="flex shrink-0 items-center gap-10 pr-10"
        aria-hidden={copy === 1 ? 'true' : undefined}
      >
        {clients.map(({ data }) => (
          <li class="shrink-0">
            <Image
              src={data.logo}
              alt={copy === 0 ? data.name : ''}
              height={80}
              densities={[1, 2]}
              class="h-20 w-auto"
            />
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>
