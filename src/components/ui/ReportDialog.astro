---
import Checkbox from './Checkbox.astro';
import InlineField from './InlineField.astro';

interface Props {
  id: string;
  action: string;
}
const { id, action } = Astro.props;
---

<dialog
  data-report-dialog
  aria-labelledby={`${id}-title`}
  class="report-dialog rounded-surface bg-white p-0 text-left"
>
  <div class="relative p-6 sm:p-10">
    <button
      type="button"
      data-report-close
      aria-label="Close"
      class="text-ocean/50 hover:text-ocean focus-visible:outline-ocean motion-ui focus-ring absolute top-2 right-1.5 flex size-11 cursor-pointer items-center justify-center transition-colors"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        class="size-6"
      >
        <path d="M4 4l16 16M20 4 4 20"></path>
      </svg>
    </button>
    <h2
      id={`${id}-title`}
      class="text-ocean sm:text-dialog pr-10 text-4xl leading-none font-normal tracking-display"
    >
      Get your report
    </h2>
    <div class="border-line-control rounded-surface from-tint mt-7 border bg-linear-to-b to-transparent p-5">
      <p class="text-ink/60 caps text-xs font-semibold">Selected issues</p>
      <ul data-report-issues role="list" class="mt-2.5 space-y-2"></ul>
      <template data-report-issue>
        <li class="flex gap-2">
          <span aria-hidden="true" class="flex h-lh shrink-0 items-center">
            <svg viewBox="0 0 16 16" class="text-ink/35 size-4">
              <circle cx="8" cy="8" r="8" fill="currentColor"></circle>
              <path
                d="M8 4.5v4"
                stroke="white"
                stroke-width="1.75"
                stroke-linecap="round"
              ></path>
              <circle cx="8" cy="11.4" r="1" fill="white"></circle>
            </svg>
          </span>
          <span class="text-ocean text-base leading-normal"></span>
        </li>
      </template>
      <div class="border-line mt-3 border-t pt-5">
        <p class="text-ink/60 caps text-xs font-semibold">Website</p>
        <p
          data-report-website
          class="text-ocean mt-0.5 truncate text-2xl leading-tight"
        ></p>
      </div>
    </div>
    <form action={action} data-report-form class="mt-5">
      <InlineField
        id={`${id}-email`}
        name="email"
        type="email"
        label="Work email"
        placeholder="you@company.com"
        autocomplete="email"
        inputmode="email"
        action="Send the Report"
        compact
      />
      <label class="group mt-0.5 flex min-h-11 w-fit cursor-pointer items-center gap-2.5">
        <Checkbox name="audit" value="yes" size="sm" />
        <span class="text-ocean text-base">Include a free technical audit</span>
      </label>
    </form>
  </div>
</dialog>
