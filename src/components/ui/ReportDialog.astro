---
import Checkbox from './Checkbox.astro';
import InlineField from './InlineField.astro';

interface Props {
  id: string;
  action: string;
}
const { id, action } = Astro.props;
const check = 'M6 12.5l4 4 8-9';
---

<dialog
  data-report-dialog
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-lead`}
  class="report-dialog rounded-surface bg-white p-0 text-left"
>
  <div class="relative p-6 sm:p-10">
    <button
      type="button"
      data-report-close
      aria-label="Close"
      class="text-ocean/60 hover:text-ocean focus-visible:outline-ocean motion-ui focus-ring absolute top-3 right-3 flex size-11 cursor-pointer items-center justify-center transition-colors sm:top-4 sm:right-4"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        class="size-5"
      >
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>
    <h2 id={`${id}-title`} class="text-ocean pr-10 text-3xl font-normal">
      Get your report
    </h2>
    <p id={`${id}-lead`} class="text-graphite/80 mt-2 text-base">
      We review your website against the issues you picked and send the findings
      to your inbox.
    </p>
    <div class="border-line-control rounded-surface from-tint mt-6 border bg-linear-to-b to-transparent p-5">
      <p class="text-ink/60 caps text-xs font-semibold">Selected issues</p>
      <ul data-report-issues role="list" class="mt-3 space-y-2.5"></ul>
      <template data-report-issue>
        <li class="flex gap-3">
          <span aria-hidden="true" class="flex h-lh shrink-0 items-center">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-azure-deep size-4"
            >
              <path d={check}></path>
            </svg>
          </span>
          <span class="text-ocean text-base leading-snug font-medium italic"></span>
        </li>
      </template>
      <div class="border-line mt-5 flex items-end justify-between gap-4 border-t pt-5">
        <div class="min-w-0">
          <p class="text-ink/60 caps text-xs font-semibold">Website</p>
          <p
            data-report-website
            class="text-ocean mt-1 truncate text-base font-medium"
          ></p>
        </div>
        <button
          type="button"
          data-report-edit
          class="text-azure-deep hover:text-ocean focus-visible:outline-ocean motion-ui focus-ring -mb-3 min-h-11 shrink-0 cursor-pointer text-sm font-semibold underline underline-offset-4 transition-colors"
        >
          Edit
        </button>
      </div>
    </div>
    <form action={action} data-report-form class="mt-6">
      <InlineField
        id={`${id}-email`}
        name="email"
        type="email"
        label="Work email"
        placeholder="you@company.com"
        autocomplete="email"
        inputmode="email"
        action="Send the Report"
      />
      <label class="group mt-5 flex min-h-11 w-fit cursor-pointer items-center gap-4">
        <Checkbox name="audit" value="yes" />
        <span class="text-ocean text-base leading-tight font-medium">
          Include a free technical audit
        </span>
      </label>
    </form>
  </div>
</dialog>
