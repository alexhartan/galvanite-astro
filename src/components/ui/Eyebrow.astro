---
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<div class="text-statement pt-cap-statement mt-cap-statement lg:absolute lg:top-0 lg:left-5 max-lg:px-6 max-lg:pb-6">
  <h2
    id={id}
    class="text-ink/60 -mt-cap-label text-xs font-semibold tracking-widest uppercase"
  >
    <slot />
  </h2>
</div>
