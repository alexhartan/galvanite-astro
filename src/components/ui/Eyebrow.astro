---
interface Props {
  id: string;
  class?: string;
  inverted?: boolean;
}
const {
  id,
  class: className = 'text-statement',
  inverted = false,
} = Astro.props;
---

<div
  class:list={[
    'pt-cap-statement mt-cap-statement lg:absolute lg:top-0 lg:left-5 lg:opacity-0 max-lg:pb-6',
    className,
  ]}
>
  <h2
    id={id}
    data-eyebrow
    class:list={[
      '-mt-cap-label text-label font-semibold tracking-widest uppercase',
      inverted ? 'text-white/60' : 'text-ink/60',
    ]}
  >
    <slot />
  </h2>
</div>
