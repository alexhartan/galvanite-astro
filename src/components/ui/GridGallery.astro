---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import billboard from '../../assets/cta/lumen-billboard.png';
import scroll3 from '../../assets/cta/scroll3.png';
import scroll4 from '../../assets/cta/scroll4.png';
import scroll42 from '../../assets/cta/scroll4-2.png';
import scroll43 from '../../assets/cta/scroll4-3.png';
import scroll6 from '../../assets/cta/scroll6.png';
import scroll61 from '../../assets/cta/scroll6-1.png';
import scroll62 from '../../assets/cta/scroll6-2.png';
import scroll63 from '../../assets/cta/scroll6-3.png';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const columns: { motion: string; duration: number; tiles: ImageMetadata[] }[] =
  [
    {
      motion: 'motion-safe:animate-marquee-up',
      duration: 70,
      tiles: [scroll3, scroll61, scroll43],
    },
    {
      motion: 'motion-safe:animate-marquee-down',
      duration: 95,
      tiles: [scroll4, scroll63, billboard],
    },
    {
      motion: 'motion-safe:animate-marquee-up',
      duration: 82,
      tiles: [scroll62, scroll42, scroll6],
    },
  ];
---

<div
  aria-hidden="true"
  class:list={['gallery-hover absolute inset-y-0', className]}
>
  <div class="flex h-full gap-5">
    {columns.map(({ motion, duration, tiles }) => (
      <div class="flex-1">
        <div
          data-gallery-track
          class:list={['flex flex-col', motion]}
          style={`--duration: ${duration}s`}
        >
          {[...tiles, ...tiles, ...tiles, ...tiles].map((tile) => (
            <div data-tile class="relative mb-5 aspect-square w-full shrink-0">
              <div data-tile-window class="absolute -inset-5">
                <Image
                  src={tile}
                  alt=""
                  format="webp"
                  widths={[240, 360, 480, 640]}
                  sizes="(min-width: 1280px) 14vw, 1px"
                  quality={72}
                  draggable="false"
                  class="size-full object-cover"
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  import { initGallery } from '../../scripts/gallery';

  document
    .querySelectorAll<HTMLElement>('[data-gallery-track]')
    .forEach((track) => initGallery(track));
</script>
