---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import ArrowIcon from './ArrowIcon.astro';
import GridMark from './GridMark.astro';
import SparkIcon from './SparkIcon.astro';

interface Props {
  data: CollectionEntry<'caseStudies'>['data'];
  index: number;
  class?: string;
  copy?: boolean;
}
const { data, index, class: className, copy = false } = Astro.props;
const Tag = data.href ? 'a' : 'div';
---

<article
  data-slide
  aria-hidden={copy ? 'true' : undefined}
  inert={copy}
  class:list={['group shrink-0', className]}
  style={`--delay: ${Math.min(index, 3) * 160}ms`}
>
  <Tag href={data.href} class="block">
    <div class="relative overflow-hidden">
      <div class="reveal-mask">
        <div class="reveal-zoom">
          <Picture
            src={data.image}
            alt={data.imageAlt}
            formats={['avif', 'webp']}
            widths={[400, 600, 800, 1200]}
            sizes="(min-width: 1024px) 40vw, (min-width: 640px) 60vw, 85vw"
            quality={78}
            draggable="false"
            class="ease-out-soft 4xl:aspect-square aspect-4/3 w-full object-cover transition-transform duration-700 group-hover:scale-104"
          />
        </div>
      </div>
      <div
        aria-hidden="true"
        class="ease-in-soft absolute top-8 right-8 opacity-0 transition-opacity duration-300 group-hover:opacity-100 lg:top-10 lg:right-10"
      >
        <svg
          viewBox="0 0 56 56"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          class="ease-out-soft size-10 -translate-x-1/2 translate-y-1/2 text-white transition-transform duration-700 group-hover:translate-0 motion-reduce:translate-0 lg:size-14"
        >
          <path d="M2 54 54 2M14 2h40v40"></path>
        </svg>
      </div>
    </div>
    <div class="relative">
      <p class="relative text-ink/80 ease-out-soft flex items-center font-medium gap-2.5 px-3 py-3.5 opacity-90 transition-opacity duration-300 group-hover:opacity-100">
        <span
          aria-hidden="true"
          class="bg-ink/10 absolute bottom-0 left-0 -right-6 h-px lg:-right-10"
        />
        <GridMark class="absolute top-full left-0 -mt-px" />
        <SparkIcon class="text-signal size-5 shrink-0" />
        <span data-rotator class="grid">
          {data.stats.map((stat, i) => {
            const cut = stat.indexOf(',') + 1;
            return (
              <span
                data-active={i === 0 ? '' : undefined}
                aria-hidden={i === 0 ? undefined : 'true'}
                class="ease-out-soft col-start-1 row-start-1 translate-y-2 opacity-0 transition duration-500 data-active:translate-y-0 data-active:opacity-100 motion-reduce:translate-y-0"
              >
                <span class="font-semibold">
                  {cut ? stat.slice(0, cut) : stat}
                </span>
                {cut > 0 && <span class="font-normal">{stat.slice(cut)}</span>}
              </span>
            );
          })}
        </span>
      </p>
      <div>
        <h4
          data-split
          class="text-card text-ink ease-out-soft mt-3 font-normal text-balance opacity-90 transition-opacity duration-300 group-hover:opacity-100"
        >
          {data.title}
        </h4>
        <ul
          class="reveal-after ease-out-soft mt-4 flex -translate-y-2 flex-wrap gap-2.25 opacity-0 transition duration-500 group-hover:translate-y-0 group-hover:opacity-100 motion-reduce:translate-y-0"
          aria-label="Scope"
        >
          {data.scope.map((item) => (
            <li class="bg-ocean-50 text-azure-deep text-tag rounded-sm px-2.5 py-1.25 font-medium tracking-wider uppercase">
              {item}
            </li>
          ))}
        </ul>
        {data.href && (
          <span class="text-ink border-ink mt-6 inline-flex items-center gap-2 border-b-2 pb-1 text-sm font-semibold">
            Read the case study
            <ArrowIcon />
          </span>
        )}
      </div>
    </div>
  </Tag>
</article>
