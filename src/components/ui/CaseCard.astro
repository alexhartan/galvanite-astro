---
import type { CollectionEntry } from 'astro:content';
import { Image, Picture } from 'astro:assets';

interface Props {
  data: CollectionEntry<'caseStudies'>['data'];
  index: number;
  class?: string;
  copy?: boolean;
}
const { data, index, class: className, copy = false } = Astro.props;
const Tag = data.href ? 'a' : 'div';
const LOGO_AREA = 187;
const logoHeight = data.logo
  ? Math.sqrt(LOGO_AREA / (data.logo.width / data.logo.height)).toFixed(2)
  : 0;
---

<article
  data-slide
  aria-hidden={copy ? 'true' : undefined}
  class:list={['group/case case-card case-motion-none shrink-0', className]}
  style={`--delay: ${Math.min(index, 3) * 150}ms`}
>
  <Tag
    href={data.href}
    tabindex={copy && data.href ? -1 : undefined}
    class="relative block focus-visible:outline-none"
  >
    <div class="case-frame">
      <div class="case-photo">
        <div class="reveal-mask size-full">
          <div class="reveal-zoom size-full">
            <Picture
              src={data.image}
              alt={data.imageAlt}
              formats={['avif', 'webp']}
              widths={[400, 600, 800, 1200]}
              sizes="(min-width: 1024px) 48vw, (min-width: 640px) 70vw, 95vw"
              quality={78}
              draggable="false"
              pictureAttributes={{ class: 'block size-full' }}
              class="size-full object-cover"
            />
          </div>
        </div>
      </div>
      <div aria-hidden="true" class="case-shade absolute inset-0"></div>
    </div>
    <div class="case-media">
      {data.logo && (
        <Image
          src={data.logo}
          alt=""
          class="case-reveal case-logo"
          style={`--logo-h: ${logoHeight}cqw`}
        />
      )}
      <div class="case-meta text-white">
        <p
          data-rotator
          class="case-reveal case-stats grid leading-tight font-medium"
        >
          {data.stats.map((stat, i) => (
            <span
              data-active={i === 0 ? '' : undefined}
              aria-hidden={i === 0 ? undefined : 'true'}
              class="motion-slow col-start-1 row-start-1 translate-y-2 opacity-0 transition data-active:translate-y-0 data-active:opacity-100 motion-reduce:translate-y-0"
            >
              {stat}
            </span>
          ))}
        </p>
        <span
          aria-hidden="true"
          class="case-rule block h-px bg-white/30"
        ></span>
      </div>
    </div>
    <h3
      data-split
      class="case-title text-card text-ocean relative font-normal text-balance"
    >
      {data.title}
    </h3>
  </Tag>
</article>
