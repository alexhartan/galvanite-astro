---
import CheckIcon from './CheckIcon.astro';

interface Props {
  weeks: number;
  stages: { name: string; short?: string; start: number; end: number }[];
}
const { weeks, stages } = Astro.props;
const label_ =
  'text-stage-sm absolute inset-0 flex items-center justify-center font-semibold tracking-wider uppercase';
---

<div
  data-timeline
  class="group/timeline @container relative py-2.5"
  style={`--weeks: ${weeks}`}
>
  <ol class="relative space-y-1">
    {stages.map(({ name, short, start, end }) => (
      <li
        data-stage
        data-end={end / weeks}
        class="group/stage stage-span relative h-5"
        style={`--start: ${start}; --end: ${end}`}
      >
        <div class="bg-ink/40 absolute inset-0 rounded-sm border border-white/10">
          <span class:list={[label_, 'text-azure']}>
            {short ? (
              <>
                <span class="@3xl:hidden">{short}</span>
                <span class="@max-3xl:hidden">{name}</span>
              </>
            ) : (
              name
            )}
          </span>
        </div>
        <div
          aria-hidden="true"
          class="stage-reveal absolute inset-0 overflow-hidden rounded-sm bg-white/90"
        >
          <div class="timeline-trail from-frost via-chalk to-night/0 absolute inset-y-0 bg-linear-to-l via-15% mix-blend-multiply" />
          <CheckIcon class="ease-out-soft absolute top-1/2 left-1 size-3 -translate-y-1/2 scale-75 opacity-0 transition-[opacity,scale] duration-300 group-data-complete/stage:scale-100 group-data-complete/stage:opacity-100" />
          <span class:list={[label_, 'text-ink']}>
            {short ? (
              <>
                <span class="@3xl:hidden">{short}</span>
                <span class="@max-3xl:hidden">{name}</span>
              </>
            ) : (
              name
            )}
          </span>
        </div>
      </li>
    ))}
  </ol>
  <div
    aria-hidden="true"
    class="timeline-line ease-out-soft absolute inset-y-0 w-px opacity-0 transition-opacity duration-500 group-data-playing/timeline:opacity-100"
  >
    <div class="line-fade size-full bg-linear-to-b from-white/10 via-white to-white/10"></div>
  </div>
</div>

<script>
  import { initTimeline } from '../../scripts/timeline';

  for (const root of document.querySelectorAll<HTMLElement>(
    '[data-timeline]',
  )) {
    initTimeline(root);
  }
</script>
